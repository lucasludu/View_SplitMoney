
<!-- Top Bar for Mobile -->
<div class="top-row d-flex align-items-center justify-content-between d-md-none px-3 shadow-sm mobile-header">
    <a class="navbar-brand brand-font m-0" href="" style="color: var(--on-surface); font-size: 1.4rem;">SplitMoney</a>
    <button class="menu-button" @onclick="ToggleNavMenu">
        <span class="icon">@(collapseNavMenu ? "☰" : "✕")</span>
    </button>
</div>

<!-- Backdrop Overlay for Mobile -->
@if (!collapseNavMenu)
{
    <div class="menu-backdrop" @onclick="CloseAllOverlays"></div>
}

<!-- Sidebar / Overlay Mobile Menu -->
<div class="sidebar-main @(collapseNavMenu ? "collapsed" : "expanded") shadow-lg">
    <!-- Header for Desktop -->
    <div class="top-row d-none d-md-flex align-items-center mb-4 px-4" style="height: 64px;">
        <a class="navbar-brand brand-font m-0" href="" style="color: var(--on-surface); font-size: 1.6rem;">SplitMoney</a>
    </div>

    <!-- Navigation Items -->
    <nav class="nav-content d-flex flex-column px-3" style="height: calc(100vh - 80px); overflow-y: auto;">
        <div class="nav-group mb-4">
            <NavLink class="editorial-nav-link" href="" Match="NavLinkMatch.All" @onclick="CloseMenu">
                <span class="nav-icon">🏠</span> <span class="nav-text">Home</span>
            </NavLink>
        </div>
        
        <div class="nav-group mb-4">
            <p class="nav-label">Operaciones</p>
            <a class="editorial-nav-link cursor-pointer" @onclick="HandleCreateExpenseNav">
                <span class="nav-icon">➕</span> <span class="nav-text">Cargar Gasto</span>
            </a>
            <NavLink class="editorial-nav-link" href="/groups" @onclick="CloseMenu">
                <span class="nav-icon">👥</span> <span class="nav-text">Mis Grupos</span>
            </NavLink>
            <NavLink class="editorial-nav-link" href="/settle" @onclick="CloseMenu">
                <span class="nav-icon">💸</span> <span class="nav-text">Saldar Cuentas</span>
            </NavLink>
        </div>

        <div class="nav-group mb-4">
            <p class="nav-label">Cuenta</p>
            <NavLink class="editorial-nav-link" href="/profile" @onclick="CloseMenu">
                <span class="nav-icon">⚙️</span> <span class="nav-text">Configuración</span>
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="mt-auto pb-5 px-2 mb-4">
                    <button class="logout-full-btn" @onclick="HandleLogout">
                        <span class="material-symbols-rounded">logout</span>
                        <span>Cerrar Sesión</span>
                    </button>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

