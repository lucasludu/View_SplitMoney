@using SplitMoney.Client.Models.ViewModels

<div class="recent-activity-container">
    <div class="d-flex justify-content-between align-items-center mb-4 px-2">
        <h5 class="section-title m-0">Actividad Reciente</h5>
        <a href="/expenses" class="view-all-link">Ver todo</a>
    </div>

    @if (Expenses == null || !Expenses.Any())
    {
        <div class="empty-state-small p-5 text-center">
            <span class="material-symbols-rounded">history</span>
            <p class="m-0 mt-2">No hay gastos recientes</p>
        </div>
    }
    else
    {
        <div class="activity-list">
            @foreach (var expense in Expenses)
            {
                <div class="activity-card" @onclick="() => OnExpenseSelected.InvokeAsync(expense.Id)">
                    <div class="activity-icon-container" style="background: @(expense.CategoryColor)20; color: @expense.CategoryColor;">
                        <span class="material-symbols-rounded">@GetCategoryIcon(expense.CategoryIcon)</span>
                    </div>
                    <div class="activity-details">
                        <p class="activity-description">@expense.Description</p>
                        <p class="activity-meta">@expense.Date.ToString("dd MMM") • @expense.GroupName</p>
                    </div>
                    <div class="activity-amount @(!expense.IsConfirmed ? "pending" : "")">
                        <p class="amount-value">@expense.Amount.ToString("C0")</p>
                        @if (!expense.IsConfirmed)
                        {
                            <span class="status-indicator">Pendiente</span>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .section-title {
        font-size: 0.9rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--on-surface-variant);
        opacity: 0.8;
    }

    .view-all-link {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--primary);
        text-decoration: none;
    }

    .activity-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .activity-card {
        background: var(--surface-container);
        border: 1px solid var(--outline-variant);
        border-radius: 1.25rem;
        padding: 1rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .activity-card:hover {
        background: var(--surface-container-high);
        transform: translateY(-2px);
    }

    .activity-card:active {
        transform: scale(0.98);
    }

    .activity-icon-container {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    .activity-details {
        flex-grow: 1;
        min-width: 0;
    }

    .activity-description {
        margin: 0;
        font-weight: 700;
        color: var(--on-surface);
        font-size: 1rem;
        text-truncate: ellipsis;
        white-space: nowrap;
        overflow: hidden;
    }

    .activity-meta {
        margin: 0;
        font-size: 0.75rem;
        color: var(--on-surface-variant);
    }

    .activity-amount {
        text-align: right;
        flex-shrink: 0;
    }

    .amount-value {
        margin: 0;
        font-weight: 800;
        color: var(--on-surface);
        font-size: 1.1rem;
    }

    .activity-amount.pending .amount-value {
        opacity: 0.6;
    }

    .status-indicator {
        font-size: 0.6rem;
        font-weight: 800;
        background: rgba(255, 180, 0, 0.1);
        color: #ffb400;
        padding: 0.1rem 0.4rem;
        border-radius: 4px;
        text-transform: uppercase;
    }

    .empty-state-small {
        background: var(--surface-container);
        border: 1px dashed var(--outline-variant);
        border-radius: 1.25rem;
        color: var(--on-surface-variant);
        font-size: 0.85rem;
    }

    .empty-state-small span {
        font-size: 2rem;
        opacity: 0.3;
    }
</style>

@code {
    [Parameter] public IEnumerable<RecentExpenseViewModel>? Expenses { get; set; }
    [Parameter] public EventCallback<Guid> OnExpenseSelected { get; set; }

    private string GetCategoryIcon(string currentIcon)
    {
        return currentIcon switch
        {
            "🛒" => "shopping_cart",
            "🍔" => "restaurant",
            "🏠" => "home",
            "🚕" => "local_taxi",
            "🎉" => "celebration",
            "💡" => "lightbulb",
            _ => "receipt_long"
        };
    }
}
