
<div class="paywall-overlay" @onclick="OnClose">
    <div class="paywall-card glass-panel shadow-lg premium-modal-anim" @onclick:stopPropagation="true">
        <div class="text-center mb-4">
            <div class="premium-icon-badge mb-3">
                <span>👥</span>
            </div>
            <h2 class="brand-font mb-2 paywall-title">@Title</h2>
        </div>

        <div class="comparison-container d-flex gap-3 mb-4">
            <div class="plan-card flex-grow-1 p-3 text-center border-0 free-plan-card">
                <div class="mb-2 plan-icon-large">👥</div>
                <p class="m-0 small text-editorial-muted">Gratis</p>
                <p class="m-0 fw-bold">3 Círculos</p>
            </div>
            <div class="plan-card flex-grow-1 p-3 text-center border-2 premium-plan-card">
                <div class="premium-sparkle-badge">✨</div>
                <div class="mb-2 plan-icon-large">🌟</div>
                <p class="m-0 small text-editorial-muted">Premium</p>
                <p class="m-0 fw-bold text-primary">Ilimitados</p>
            </div>
        </div>

        <div class="description-section px-2 mb-4 text-center">
            <p class="small mb-4 description-text">
                Has llegado al máximo de grupos para tu plan. Desbloquea todo el potencial, crea grupos sin límites y accede a análisis avanzados.
            </p>
            
            <ul class="list-unstyled text-start mb-0 d-inline-block feature-list">
                <li class="mb-2 d-flex align-items-center gap-2">
                    <span class="text-success">✔</span> <span>Círculos ilimitados</span>
                </li>
                <li class="mb-2 d-flex align-items-center gap-2">
                    <span class="text-success">✔</span> <span>Exportación a Excel y PDF</span>
                </li>
                <li class="mb-2 d-flex align-items-center gap-2">
                    <span class="text-success">✔</span> <span>Gráficos y Estadísticas Pro</span>
                </li>
            </ul>
        </div>

        <button class="editorial-button-primary emerald-gradient w-100 py-3 mb-3" @onclick="HandleUpgrade">
            Pasarme a Premium 🚀
        </button>
        
        <button class="btn btn-link text-editorial-muted w-100 p-0 text-decoration-none dismiss-btn mb-1" @onclick="OnClose">
            Quizás en otro momento
        </button>

        @if (OnSimulate.HasDelegate)
        {
            <div class="mt-4 pt-3 border-top border-secondary opacity-50 simulation-zone">
                <button class="btn btn-sm btn-outline-warning w-100 rounded-pill simulation-btn" @onclick="HandleSimulate" style="font-size: 0.75rem; font-weight: 500;">
                    🧪 [SIMULAR PAGO EXITOSO]
                </button>
                <p class="text-center x-small text-editorial-muted m-0 p-1" style="font-size: 0.6rem;">Solo modo desarrollo</p>
            </div>
        }
    </div>
</div>
