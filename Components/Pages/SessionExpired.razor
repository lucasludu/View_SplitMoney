@page "/session-expired"
@layout SplitMoney.Client.Components.Layout.EmptyLayout

<div class="container d-flex align-items-center justify-content-center min-vh-100 px-4">
    <div class="editorial-card text-center shadow-lg border-warning py-6 px-4 session-expired-card">
        <div class="mb-5 mx-auto session-expired-icon-box">
            ⏳
        </div>
        <h1 class="brand-font mb-3 session-expired-title">Sesión Expirada</h1>
        <p class="mx-auto mb-5 session-expired-text">
            Tu tiempo de inactividad ha cerrado la conexión por seguridad. Por favor, vuelve a iniciar sesión para seguir dividiendo gastos.
        </p>
        <div class="d-grid gap-3">
            <a href="/login" class="editorial-button-primary d-inline-flex align-items-center justify-content-center gap-2 login-again-btn">
                <span class="fw-800">Iniciar Sesión de Nuevo</span>
                <span style="font-size: 1.25rem;">🔑</span>
            </a>
        </div>
    </div>
</div>
