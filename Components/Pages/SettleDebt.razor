@page "/settle"
@using SplitMoney.Client.Services
@using SplitMoney.Client.Models.ViewModels
@using System.Security.Claims
@attribute [Authorize]
@inject NavigationManager Navigation
@inject IExpenseService ExpenseService
@inject IToastService ToastService
@inject AuthenticationStateProvider AuthStateProvider

<div class="container-fluid px-3 py-4 p-md-4" style="max-width: 600px; margin: 0 auto;">
    
    <!-- Header -->
    <div class="d-flex align-items-center mb-5 gap-3">
        <button class="btn-close-custom" style="width: 44px; height: 44px;" @onclick="GoBack">⬅️</button>
        <div>
            <p class="mb-1" style="color: var(--on-surface-variant); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em;">Gestión de Cuentas</p>
            <h1 class="brand-font m-0 h2">Saldar Deudas</h1>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted">Buscando tus deudas pendientes...</p>
        </div>
    }
    else if (myDebts == null || !myDebts.Any())
    {
        <div class="editorial-card text-center py-6 px-4 shadow-lg border-success" style="background: linear-gradient(145deg, var(--surface-container-low), var(--surface-container-high)); border: 1.5px dashed #10b981; opacity: 0.9;">
            <div class="mb-4 mx-auto" style="width: 100px; height: 100px; background: rgba(16, 185, 129, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 3.5rem;">
                ✨
            </div>
            <h2 class="brand-font mb-3">¡Estás al día!</h2>
            <p class="mx-auto mb-0" style="color: var(--on-surface-variant); max-width: 400px; line-height: 1.6;">
                No tienes deudas pendientes en ninguno de tus círculos. ¡Cuentas claras, amistades largas!
            </p>
        </div>
    }
    else
    {
        <div class="mb-5">
            <h5 class="section-label mb-3">TUS DEUDAS ACTIVAS</h5>
            <div class="d-flex flex-column gap-3">
                @foreach (var debt in myDebts)
                {
                    <div class="balance-item p-3 d-flex justify-content-between align-items-center shadow-sm" style="border-left: 5px solid #ef4444; background: var(--surface-container-high);">
                        <div class="d-flex align-items-center gap-3">
                            <div class="member-avatar" style="background: var(--surface-container-highest); color: var(--on-surface);">@debt.CreditorName.Substring(0, 1).ToUpper()</div>
                            <div>
                                <p class="m-0 fw-bold">Debes a @debt.CreditorName</p>
                                <p class="m-0 x-small text-muted">En el círculo: @debt.GroupName</p>
                            </div>
                        </div>
                        <div class="text-end">
                            <p class="m-0 fw-bold text-danger" style="font-size: 1.2rem;">@debt.Amount.ToString("C2")</p>
                            <button class="btn btn-sm btn-outline-danger mt-1 rounded-pill px-3" style="font-size: 0.7rem; font-weight: 700;" @onclick="() => SelectDebt(debt)">SALDAR</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Settlement Form Overlay -->
    @if (showForm)
    {
        <div class="details-overlay" @onclick="() => showForm = false">
            <div class="details-panel shadow-lg p-5" @onclick:stopPropagation="true">
                <div class="text-center mb-5">
                    <div class="mx-auto mb-4" style="width: 80px; height: 80px; background: linear-gradient(135deg, var(--primary), #8E2DE2); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; color: white;">
                        💸
                    </div>
                    <p class="editorial-label">Confirma el pago a @selectedCreditorName</p>
                    <div class="d-flex align-items-center justify-content-center">
                        <span class="brand-font" style="font-size: 2rem; color: var(--primary); margin-right: 0.5rem;">$</span>
                        <input type="number" step="0.01"
                               class="brand-font text-center" 
                               style="background: transparent; border: none; color: white; font-size: 3.5rem; width: 100%; outline: none;" 
                               @bind="settlement.Amount" />
                    </div>
                </div>

                <div class="editorial-input-group mb-5">
                    <label class="editorial-label">Medio de Pago</label>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var method in paymentMethods)
                        {
                            <button type="button" 
                                    class="btn btn-sm px-3 py-2 rounded-pill" 
                                    style="@(selectedMethod == method ? "background: var(--primary); color: white;" : "background: var(--surface-container-high); color: var(--on-surface-variant); border: 1px solid var(--outline-variant);")"
                                    @onclick="() => selectedMethod = method">
                                @method
                            </button>
                        }
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <button class="editorial-button-secondary w-50" @onclick="() => showForm = false">Cancelar</button>
                    <button type="button" class="editorial-button-primary w-50" disabled="@submitting" @onclick="HandleSubmit">
                        @if (submitting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                        }
                        else
                        {
                            <span>Pagar Ahora 🚀</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private SettleDebtModel settlement = new();
    private List<DebtSummaryViewModel> myDebts = new();
    private bool isLoading = true;
    private bool showForm = false;
    private string selectedCreditorName = "";
    private string selectedMethod = "💸 Efectivo";
    private bool submitting = false;
    private List<string> paymentMethods = new() { "💸 Efectivo", "🏦 Transferencia", "📱 Mercado Pago" };

    protected override async Task OnInitializedAsync()
    {
        await LoadMyDebts();
    }

    private async Task LoadMyDebts()
    {
        isLoading = true;
        myDebts.Clear();
        
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var currentUserId = authState.User.Claims.FirstOrDefault(c => c.Type == "sub" || c.Type == ClaimTypes.NameIdentifier)?.Value;
            
            var groups = await ExpenseService.GetUserGroupsAsync();
            
            foreach (var group in groups)
            {
                var balances = await ExpenseService.GetGroupBalancesAsync(group.Id);
                var activeDebts = balances
                    .Where(b => b.DebtorId == currentUserId)
                    .Select(b => new DebtSummaryViewModel 
                    {
                        GroupId = Guid.Parse(group.Id),
                        GroupName = group.Name,
                        CreditorId = b.CreditorId,
                        CreditorName = b.CreditorName,
                        Amount = b.Amount
                    });
                
                myDebts.AddRange(activeDebts);
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectDebt(DebtSummaryViewModel debt)
    {
        settlement = new SettleDebtModel 
        {
            GroupId = debt.GroupId,
            PayeeId = debt.CreditorId,
            Amount = Math.Round(debt.Amount, 2)
        };
        selectedCreditorName = debt.CreditorName;
        showForm = true;
    }

    private void GoBack() => Navigation.NavigateTo("/");

    private async Task HandleSubmit()
    {
        if (settlement.Amount <= 0)
        {
            ToastService.ShowToast("Monto inválido", ToastLevel.Warning);
            return;
        }

        submitting = true;
        var success = await ExpenseService.SettleDebtAsync(settlement);
        submitting = false;

        if (success)
        {
            ToastService.ShowToast($"¡Pago registrado! Cuentas saldadas con {selectedCreditorName} ✅", ToastLevel.Success);
            showForm = false;
            await LoadMyDebts();
        }
        else
        {
            ToastService.ShowToast("Error al procesar el pago", ToastLevel.Error);
        }
    }

    private class DebtSummaryViewModel
    {
        public Guid GroupId { get; set; }
        public string GroupName { get; set; } = "";
        public string CreditorId { get; set; } = "";
        public string CreditorName { get; set; } = "";
        public decimal Amount { get; set; }
    }
}
