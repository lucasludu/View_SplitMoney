@page "/groups"
@using SplitMoney.Client.Services
@using SplitMoney.Client.Models.ViewModels
@attribute [Authorize]
@inject IExpenseService ExpenseService
@inject NavigationManager Navigation
@inject IToastService ToastService
@inject IModalService ModalService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@using SplitMoney.Client.Components.Dashboard

<div class="container-fluid px-3 py-4 p-md-4 groups-container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <p class="mb-1 header-tag">Gestión</p>
            <h1 class="brand-font m-0 h1-responsive">Mis Grupos</h1>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="d-flex flex-column gap-3">
            @for (int i = 0; i < 4; i++)
            {
                <div class="skeleton" style="height: 80px; border-radius: 1rem; width: 100%;"></div>
            }
        </div>
    }
    else if (groups == null || !groups.Any())
    {
        <div class="editorial-card text-center py-6 px-4 shadow-lg border-primary empty-groups-card">
            <div class="mb-4 mx-auto empty-groups-icon-box">
                👥
            </div>
            <h2 class="brand-font mb-3 empty-groups-title">No hay grupos creados</h2>
            <p class="mx-auto mb-4 empty-groups-text">
                Crea un grupo para empezar a dividir gastos con tus amigos y familiares.
            </p>
            <button class="editorial-button-primary d-inline-flex align-items-center justify-content-center gap-2" style="width: auto; padding: 0.8rem 2rem;" @onclick="NavigateToCreateGroup">
                <span>Crear mi primer grupo</span>
                <span style="font-size: 1.2rem;">✨</span>
            </button>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var group in groups)
            {
                <div class="group-card d-flex align-items-center justify-content-between p-3" @onclick="() => ShowGroupDetails(group)">
                    <div class="d-flex align-items-center gap-3">
                        <div class="group-icon">
                            @group.Name.Substring(0, 1).ToUpper()
                        </div>
                        <div>
                            <h3 class="m-0 h5 fw-bold group-item-title">@group.Name</h3>
                            <p class="m-0 small" style="color: var(--on-surface-variant); opacity: 0.9; font-weight: 500;">Ver balances y miembros</p>
                        </div>
                    </div>
                    <div class="text-primary group-item-arrow">
                        ➡️
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (showPaywall)
{
    <PremiumPaywall Title="@paywallTitle" OnClose="() => showPaywall = false" OnUpgrade="HandleUpgrade" OnSimulate="HandleSimulatePremium" />
}

<!-- Group Details Modal/Overlay -->
@if (selectedGroup != null)
{
    <div class="details-overlay" @onclick="CloseDetails">
        <div class="details-panel shadow-lg" @onclick:stopPropagation="true">
            <div class="d-flex justify-content-between align-items-center mb-4 p-4 border-bottom panel-header-container">
                <div class="d-flex align-items-center gap-3">
                    <div class="group-icon panel-group-icon">
                        @selectedGroup.Name.Substring(0, 1).ToUpper()
                    </div>
                    <h2 class="brand-font m-0 h4">@selectedGroup.Name</h2>
                </div>
                <button class="btn-close-custom" @onclick="CloseDetails">✕</button>
            </div>

            <div class="p-4" style="overflow-y: auto; max-height: calc(85vh - 100px);">
                @if (loadingDetails)
                {
                    <div class="skeleton mb-4" style="height: 120px; border-radius: 1.5rem;"></div>
                    <div class="skeleton mb-4" style="height: 200px; border-radius: 1.5rem;"></div>
                }
                else if (breakdown != null)
                {
                    <!-- Summary Card -->
                    <div class="editorial-card mb-4 p-4 text-center shadow-sm summary-total-hero">
                        <p class="editorial-label mb-1" style="font-size: 0.7rem;">Gasto Total del Círculo</p>
                        <h2 class="brand-font display-6 m-0" style="color: var(--primary);">@breakdown.TotalGroupExpense.ToString("C0")</h2>
                        <div class="mt-3 d-flex justify-content-center gap-2">
                             <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 members-active-badge">
                                @members?.Count miembros activos
                             </span>
                        </div>
                    </div>

                    <!-- Analytics Section (Premium) -->
                    <div class="mb-5">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                             <h4 class="brand-font m-0 h6 premium-analytics-title">Distribución de Gastos @(!isPremium ? "👑" : "")</h4>
                             @if (isPremium)
                             {
                                 <button class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="HandleExport" disabled="@exporting" style="font-size: 0.75rem;">
                                     @if (exporting) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                     <span>Excel 📄</span>
                                 </button>
                             }
                        </div>

                        @if (!isPremium)
                        {
                            <div class="p-4 rounded-4 text-center cursor-pointer premium-locked-card" @onclick='() => ShowPaywall("Analíticas Pro")'>
                                <span style="font-size: 2rem;">📊</span>
                                <p class="mt-2 mb-1 fw-bold">Desbloquea Estadísticas Visuales</p>
                                <p class="text-editorial-muted small mb-0">Analiza en qué gasta el grupo con gráficos detallados.</p>
                            </div>
                        }
                        else if (loadingSummary)
                        {
                            <div class="text-center py-4">
                                <div class="spinner-border spinner-border-sm text-primary"></div>
                            </div>
                        }
                        else if (spendingSummary != null && spendingSummary.Categories.Any())
                        {
                            <div class="row align-items-center">
                                <div class="col-md-6 mb-4 mb-md-0">
                                    <DonutChart Data="spendingSummary.Categories" Total="spendingSummary.TotalGroupSpending" Size="180" />
                                </div>
                                <div class="col-md-6">
                                    <div class="d-flex flex-column gap-2">
                                        @foreach (var cat in spendingSummary.Categories.Take(5))
                                        {
                                            <div class="d-flex align-items-center justify-content-between small">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div style="width: 10px; height: 10px; border-radius: 50%; background: @cat.CategoryColor;"></div>
                                                    <span class="text-editorial-muted">@cat.CategoryIcon @cat.CategoryName</span>
                                                </div>
                                                <span class="fw-bold">@cat.Percentage.ToString("0")%</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="text-center text-editorial-muted small">No hay suficientes gastos para generar estadísticas.</p>
                        }
                    </div>

                    <!-- Breakdown List -->
                    <div class="mb-5">
                        <h5 class="section-label mb-3">DESGLOSE POR MIEMBRO</h5>
                        <div class="d-flex flex-column gap-2">
                            @foreach (var m in breakdown.Members)
                            {
                                <div class="balance-item p-3 d-flex justify-content-between align-items-center" style="border-left: 4px solid @(m.NetBalance >= 0 ? "#10b981" : "#ef4444");">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="member-avatar" style="width: 36px; height: 36px; background: var(--surface-container-highest); color: var(--on-surface);">
                                            @m.FullName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <p class="m-0 fw-bold member-row-name">@m.FullName</p>
                                            <p class="m-0 small text-editorial-muted">@m.TransactionCount transacciones</p>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        @if (m.NetBalance > 0)
                                        {
                                            <p class="m-0 small text-success fw-bold text-uppercase net-balance-label">Le deben</p>
                                            <p class="m-0 fw-bold text-success net-balance-value">+@m.NetBalance.ToString("C0")</p>
                                        }
                                        else if (m.NetBalance < 0)
                                        {
                                            <p class="m-0 small text-danger fw-bold text-uppercase net-balance-label">Debe</p>
                                            <p class="m-0 fw-bold text-danger net-balance-value">@m.NetBalance.ToString("C0")</p>
                                        }
                                        else
                                        {
                                            <p class="m-0 small text-editorial-muted fw-bold text-uppercase net-balance-label">Al día</p>
                                            <p class="m-0 fw-bold text-editorial-muted net-balance-value">$0</p>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Balances Section (Debts between people) -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="section-label m-0">PLAN DE PAGOS (LIQUIDACIÓN)</h5>
                            @if (balances != null && balances.Any())
                            {
                                <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle" style="font-size: 0.65rem;">Pendiente</span>
                            }
                        </div>
                        
                        @if (balances == null || !balances.Any())
                        {
                            <div class="text-center py-5 px-3 rounded-4 saldado-card">
                                <span style="font-size: 2.5rem;">🎉</span>
                                <p class="mt-3 mb-1 fw-bold h5 brand-font">¡Todo saldado!</p>
                                <p class="small text-editorial-muted mb-0">Nadie le debe a nadie en este círculo.</p>
                            </div>
                        }
                        else
                        {
                            <div class="balances-list">
                                @foreach (var balance in balances)
                                {
                                    <div class="balance-item p-3 mb-2" style="background: rgba(var(--primary-rgb), 0.03);">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="debt-item-info">
                                                <span class="fw-bold text-danger">@balance.DebtorName</span>
                                                <span class="mx-1" style="opacity: 0.6;">paga a</span>
                                                <span class="fw-bold text-success">@balance.CreditorName</span>
                                            </div>
                                            <div class="amount-badge bg-primary text-white border-0">
                                                @balance.Amount.ToString("C0")
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            
            <div class="p-4 border-top text-center" style="border-color: var(--outline-variant) !important;">
                <button class="editorial-button-primary w-100" @onclick="NavigateToNewExpense">
                    Cargar Gasto en este Grupo 🚀
                </button>
            </div>
        </div>
    </div>
}

<!-- Floating Action Button -->
<button class="fab-button shadow-lg" @onclick="NavigateToCreateGroup" title="Nuevo Grupo">
    <span style="font-size: 2rem; line-height: 1;">+</span>
</button>

@code {
    private List<GroupSummaryViewModel>? groups;
    private GroupSpendingBreakdownViewModel? breakdown;
    private List<GroupMemberResponse>? members;
    private List<BalanceResponse>? balances;
    private GroupSpendingSummaryViewModel? spendingSummary;
    private GroupSummaryViewModel? selectedGroup;
    private bool isLoading = true;
    private bool loadingDetails = false;
    private bool loadingSummary = false;
    private bool exporting = false;
    private bool isPremium = false;
    private bool showPaywall = false;
    private string paywallTitle = "Función Premium";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        
        // Cargar estado premium real o simulado
        var isRealPremium = authState.User.IsInRole("PremiumUser");
        var isSimulatedPremium = await LocalStorage.GetItemAsync<bool>("is_simulated_premium");
        isPremium = isRealPremium || isSimulatedPremium;

        groups = await ExpenseService.GetUserGroupsAsync();
        isLoading = false;
    }

    private async Task ShowGroupDetails(GroupSummaryViewModel group)
    {
        selectedGroup = group;
        loadingDetails = true;
        loadingSummary = true;
        spendingSummary = null;

        StateHasChanged();
        
        try 
        {
            var breakdownTask = ExpenseService.GetGroupSpendingBreakdownAsync(group.Id);
            var membersTask = ExpenseService.GetGroupMembersAsync(group.Id);
            var balancesTask = ExpenseService.GetGroupBalancesAsync(group.Id);
            var summaryTask = isPremium 
                ? ExpenseService.GetGroupSpendingSummaryAsync(Guid.Parse(group.Id)) 
                : Task.FromResult<GroupSpendingSummaryViewModel?>(null);

            await Task.WhenAll(breakdownTask, membersTask, balancesTask, summaryTask);
            
            breakdown = breakdownTask.Result;
            members = membersTask.Result;
            balances = balancesTask.Result;
            spendingSummary = summaryTask.Result;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading group details: {ex.Message}");
            ModalService.ShowModal("Error de Sincronización", "No se pudieron obtener los detalles de este círculo en este momento.", ModalType.Error);
        }
        finally
        {
            loadingDetails = false;
            loadingSummary = false;
            StateHasChanged();
        }
    }
    
    private async Task HandleExport()
    {
        if (selectedGroup == null) return;
        
        exporting = true;
        try
        {
            var data = await ExpenseService.ExportGroupReportAsync(Guid.Parse(selectedGroup.Id));
            if (data != null)
            {
                var fileName = $"Reporte_{selectedGroup.Name}_{DateTime.Now:yyyyMMdd}.csv";
                await JSRuntime.InvokeVoidAsync("downloadFile", fileName, "text/csv", Convert.ToBase64String(data));
                ModalService.ShowModal("Exportación Exitosa", $"El reporte '{fileName}' fue generado y descargado correctamente.", ModalType.Success);
            }
            else
            {
                ModalService.ShowModal("Error de Exportación", "No pudimos generar el reporte excel para este círculo.", ModalType.Error);
            }
        }
        finally
        {
            exporting = false;
        }
    }

    private void ShowPaywall(string title)
    {
        paywallTitle = title;
        showPaywall = true;
    }

    private void HandleUpgrade()
    {
        Navigation.NavigateTo("/premium");
    }

    private async Task HandleSimulatePremium() 
    {
        isPremium = true;
        await LocalStorage.SetItemAsync("is_simulated_premium", true);
        ModalService.ShowModal("Simulación Activa", "Modo premium habilitado en este entorno de desarrollo.", ModalType.Warning);
        
        // Si hay un grupo seleccionado, recargar sus detalles para traer el summary premium
        if (selectedGroup != null)
        {
            await ShowGroupDetails(selectedGroup);
        }
        else
        {
            StateHasChanged();
        }
    }

    private void CloseDetails()
    {
        selectedGroup = null;
        members = null;
        breakdown = null;
        spendingSummary = null;
    }
    
    private void NavigateToCreateGroup() 
    {
        if (!isPremium && groups?.Count >= 3)
        {
            ShowPaywall("Límite de Grupos Alcanzado");
            return;
        }
        Navigation.NavigateTo("/groups/new");
    }
    
    private void NavigateToNewExpense()
    {
        if (selectedGroup != null)
        {
            Navigation.NavigateTo($"/expenses/new?groupId={selectedGroup.Id}");
        }
    }
}
