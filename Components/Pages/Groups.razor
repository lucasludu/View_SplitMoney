@page "/groups"
@using SplitMoney.Client.Services
@using SplitMoney.Client.Models.ViewModels
@using SplitMoney.Client.Components.Dashboard
@attribute [Authorize]

<div class="container-fluid px-3 py-4 p-md-4 groups-container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-5 fade-in">
        <div>
            <p class="header-tag mb-1">Tu Red</p>
            <h1 class="brand-font m-0 h1-responsive">Mis Círculos</h1>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="d-flex flex-column gap-3">
            @for (int i = 0; i < 4; i++)
            {
                <div class="skeleton" style="height: 90px; border-radius: 1.5rem; width: 100%;"></div>
            }
        </div>
    }
    else if (groups == null || !groups.Any())
    {
        <div class="empty-dashboard-card text-center p-5 mb-4 fade-in">
            <div class="empty-icon-box mb-4">
                <span class="material-symbols-rounded">group</span>
            </div>
            <h2 class="brand-font mb-3">No hay círculos aún</h2>
            <p class="empty-text mb-5">
                Crea un grupo para empezar a dividir gastos con tus amigos y familiares de forma inteligente.
            </p>
            <button class="editorial-button-primary d-inline-flex align-items-center justify-content-center gap-2" style="width: auto; padding: 1rem 2.5rem;" @onclick="NavigateToCreateGroup">
                <span>Crear mi primer grupo</span>
                <span class="material-symbols-rounded">add_circle</span>
            </button>
        </div>
    }
    else
    {
        <div class="groups-grid">
            @foreach (var group in groups)
            {
                <div class="group-card fade-in-up" @onclick="() => ShowGroupDetails(group)">
                     <div class="group-card-content">
                         <div class="group-icon-container">
                             <span class="material-symbols-rounded">groups</span>
                         </div>
                         <div class="group-info">
                             <h3 class="group-name">@group.Name</h3>
                             <p class="group-subtext">Ver balances y deudas</p>
                         </div>
                         <div class="group-action">
                             <span class="material-symbols-rounded">arrow_forward_ios</span>
                         </div>
                     </div>
                </div>
            }
        </div>
    }
</div>

@if (showPaywall)
{
    <PremiumPaywall Title="@paywallTitle" OnClose="() => showPaywall = false" OnUpgrade="HandleUpgrade" OnSimulate="HandleSimulatePremium" />
}

<!-- Group Details Modal/Overlay -->
@if (selectedGroup != null)
{
    <div class="details-overlay" @onclick="CloseDetails">
        <div class="details-panel shadow-lg" @onclick:stopPropagation="true">
            <div class="panel-header border-bottom">
                <div class="d-flex align-items-center justify-content-between w-100">
                    <div class="d-flex align-items-center gap-3">
                        <div class="panel-icon-box">
                            <span class="material-symbols-rounded">groups</span>
                        </div>
                        <div>
                            <h2 class="brand-font m-0 h4">@selectedGroup.Name</h2>
                            <p class="text-editorial-muted small m-0">Detalles del Círculo</p>
                        </div>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        <button class="icon-btn" @onclick="NavigateToEditGroup" title="Editar Grupo">
                            <span class="material-symbols-rounded">edit</span>
                        </button>
                        <button class="icon-btn close-btn" @onclick="CloseDetails">
                            <span class="material-symbols-rounded">close</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="panel-body p-4 custom-scroll">
                @if (loadingDetails)
                {
                    <div class="skeleton mb-4" style="height: 140px; border-radius: 1.5rem;"></div>
                    <div class="skeleton mb-4" style="height: 250px; border-radius: 1.5rem;"></div>
                }
                else if (breakdown != null)
                {
                    <!-- Summary Card -->
                    <div class="summary-hero mb-5">
                        <div class="summary-item">
                            <p class="summary-label">Gasto Total</p>
                            <h2 class="summary-value">@breakdown.TotalGroupExpense.ToString("C0")</h2>
                        </div>
                        <div class="summary-divider"></div>
                        <div class="summary-item">
                            <p class="summary-label">Miembros</p>
                            <h2 class="summary-value">@members?.Count</h2>
                        </div>
                    </div>

                    <!-- Analytics Section (Premium) -->
                    <div class="section-container mb-5">
                        <div class="d-flex align-items-center justify-content-between mb-4">
                             <h5 class="section-title m-0">Análisis Visual @(!isPremium ? "👑" : "")</h5>
                             @if (isPremium)
                             {
                                 <button class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="HandleExport" disabled="@exporting">
                                     @if (exporting) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                     <span class="material-symbols-rounded" style="font-size: 0.9rem; vertical-align: middle;">download</span>
                                     <span>Excel</span>
                                 </button>
                             }
                        </div>

                        @if (!isPremium)
                        {
                            <div class="premium-locked-box" @onclick='() => ShowPaywall("Analíticas Pro")'>
                                <span class="material-symbols-rounded premium-icon">pie_chart</span>
                                <p class="locked-title">Desbloquea Gráficos</p>
                                <p class="locked-text">Analiza los gastos del grupo con visualizaciones detalladas.</p>
                                <span class="unlock-link">Mejorar ahora</span>
                            </div>
                        }
                        else if (loadingSummary)
                        {
                            <div class="text-center py-5">
                                <div class="spinner-border text-primary"></div>
                            </div>
                        }
                        else if (spendingSummary != null && spendingSummary.Categories.Any())
                        {
                            <div class="analytics-card p-4">
                                <div class="row align-items-center">
                                    <div class="col-md-6 mb-4 mb-md-0 text-center">
                                        <DonutChart Data="spendingSummary.Categories" Total="spendingSummary.TotalGroupSpending" Size="160" />
                                    </div>
                                    <div class="col-md-6">
                                        <div class="category-legend">
                                            @foreach (var cat in spendingSummary.Categories.Take(5))
                                            {
                                                <div class="legend-item">
                                                    <div class="legend-color" style="background: @cat.CategoryColor;"></div>
                                                    <span class="legend-name">@cat.CategoryName</span>
                                                    <span class="legend-pct">@cat.Percentage.ToString("0")%</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Balances Section -->
                    <div class="section-container mb-5">
                        <h5 class="section-title mb-4">Estado de Miembros</h5>
                        <div class="member-list">
                            @foreach (var m in breakdown.Members)
                            {
                                var displayName = GetMemberDisplayName(m.UserId, m.FullName);
                                <div class="member-card @(m.NetBalance > 0 ? "positive" : m.NetBalance < 0 ? "negative" : "neutral")">
                                    <div class="member-info">
                                        <div class="member-avatar">
                                            @(string.IsNullOrEmpty(displayName) ? "?" : displayName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div class="member-text">
                                            <p class="member-name">@displayName</p>
                                            <p class="member-meta">@m.TransactionCount movimientos</p>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="member-balance">
                                            @if (m.NetBalance > 0)
                                            {
                                                <span class="balance-tag positive">A RECIBIR</span>
                                                <p class="balance-value positive">+@m.NetBalance.ToString("C0")</p>
                                            }
                                            else if (m.NetBalance < 0)
                                            {
                                                <span class="balance-tag negative">DEBE</span>
                                                <p class="balance-value negative">@m.NetBalance.ToString("C0")</p>
                                            }
                                            else
                                            {
                                                <span class="balance-tag neutral">AL DÍA</span>
                                                <p class="balance-value neutral">$0</p>
                                            }
                                        </div>
                                        @if (ShouldShowInviteButton(m.UserId))
                                        {
                                            <button class="invite-share-btn" @onclick="() => CompartirEnlaceInvitacion(m.UserId)" title="Compartir invitación o recordatorio">
                                                <span class="material-symbols-rounded">share</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Payment Plan -->
                    <div class="section-container mb-4">
                        <h5 class="section-title mb-4">Plan de Liquidación</h5>
                        @if (balances == null || !balances.Any())
                        {
                            <div class="settled-box p-5">
                                <span class="material-symbols-rounded settled-icon">verified</span>
                                <h4 class="brand-font m-0 mt-3">¡Círculo en Paz!</h4>
                                <p class="text-editorial-muted small m-0 mt-1">Todas las deudas están saldadas.</p>
                            </div>
                        }
                        else
                        {
                            <div class="payment-list">
                                @foreach (var balance in balances)
                                {
                                    <div class="payment-card">
                                        <div class="payment-flow">
                                            <span class="payer">@GetMemberDisplayName(balance.DebtorId, balance.DebtorName)</span>
                                            <span class="material-symbols-rounded arrow">trending_flat</span>
                                            <span class="payee">@GetMemberDisplayName(balance.CreditorId, balance.CreditorName)</span>
                                        </div>
                                        <div class="payment-amount">
                                            @balance.Amount.ToString("C0")
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            
            <div class="panel-footer p-4 border-top">
                <button class="btn-primary-modern mb-3" @onclick="NavigateToNewExpense">
                    <span>Cargar Gasto</span>
                    <span class="material-symbols-rounded">add_circle</span>
                </button>
                <button class="btn-text-danger" @onclick="ConfirmDeleteGroup">
                    <span class="material-symbols-rounded">delete</span>
                    Eliminar Círculo
                </button>
            </div>
        </div>
    </div>
}

<!-- Floating Action Button -->
<button class="fab-button shadow-lg" @onclick="NavigateToCreateGroup" title="Nuevo Grupo">
    <span class="material-symbols-rounded">add</span>
</button>
