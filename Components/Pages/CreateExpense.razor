@page "/expenses/new"
@page "/expenses/edit/{ExpenseId:guid}"
@using SplitMoney.Client.Services
@using SplitMoney.Client.Models.ViewModels
@using System.Security.Claims
@attribute [Authorize]
@inject NavigationManager Navigation
@inject IExpenseService ExpenseService
@inject IToastService ToastService
@inject AuthenticationStateProvider AuthStateProvider
@using SplitMoney.Client.Components.Dashboard

<div class="container-fluid px-3 py-4 p-md-4 create-expense-container" @onclick="CloseDropdowns">
    
    <!-- Header with Back Button -->
    <div class="d-flex align-items-center mb-5 gap-3">
        <button class="btn rounded-circle back-btn" @onclick="GoBack">
            <span>⬅️</span>
        </button>
        <div>
            <p class="mb-1 header-subtitle">@(ExpenseId.HasValue ? "Modificar" : "Nuevo") Registro</p>
            <h1 class="brand-font m-0 h2-responsive">@(ExpenseId.HasValue ? "Editar Gasto" : "Cargar Nuevo Gasto")</h1>
        </div>
    </div>

    @if (loadingGroups)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Main Content Column -->
            <div class="col-12 col-lg-7">
                <div class="editorial-card shadow-lg p-4">
                    
                    <!-- Basic Info -->
                    <div class="row g-3 mb-5">
                        <div class="col-12">
                            <label class="editorial-label">¿En qué grupo fue?</label>
                            <select class="editorial-input" @bind="SelectedGroupId">
                                <option value="" disabled>Selecciona un grupo...</option>
                                @foreach (var g in userGroups)
                                {
                                    <option value="@g.Id">@g.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-8">
                            <label class="editorial-label">Descripción</label>
                            <input type="text" class="editorial-input" placeholder="Ej: Cena en Palermo" @bind="expense.Title" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="editorial-label">Monto Total ($)</label>
                            <input type="number" class="editorial-input brand-font fw-bold total-amount-input" @bind="expense.TotalAmount" @bind:event="oninput" @onchange="DistributeEquallyIfFirstTime" />
                        </div>
                    </div>

                    <!-- Category Selection -->
                    <div class="mb-5 position-relative">
                        <label class="editorial-label mb-3">Categoría</label>
                        <div class="editorial-input d-flex align-items-center justify-content-between category-trigger" 
                             @onclick="ToggleCategoryDropdown" @onclick:stopPropagation="true"
                             style="border: 1.5px solid @(SelectedCategory?.ColorHex ?? "var(--outline-variant)");">
                            
                            @if (SelectedCategory != null)
                            {
                                <div class="d-flex align-items-center gap-3">
                                    <span style="font-size: 1.3rem;">@SelectedCategory.IconIdentifier</span>
                                    <span class="fw-bold" style="color: var(--on-surface); font-size: 0.95rem;">@SelectedCategory.Name</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-editorial-muted fw-bold" style="color: var(--on-surface-variant) !important; font-size: 0.95rem;">Selecciona una categoría...</span>
                            }
                            
                            <span class="dropdown-arrow" style="transform: rotate(@(isCategoryDropdownOpen ? "180deg" : "0deg"));">▼</span>
                        </div>

                        @if (isCategoryDropdownOpen)
                        {
                            <div class="position-absolute w-100 mt-2 shadow-lg rounded-4 custom-scrollbar category-dropdown-panel">
                                @foreach (var cat in categories)
                                {
                                    <div class="p-3 d-flex align-items-center gap-3 category-option @(expense.CategoryId == cat.Id ? "active" : "")" 
                                         @onclick="() => SelectCategory(cat.Id)" @onclick:stopPropagation="true">
                                        <div class="category-icon-wrapper" style="background: @(cat.ColorHex)20; border: 1px solid @cat.ColorHex;">
                                            <span style="font-size: 1.2rem;">@cat.IconIdentifier</span>
                                        </div>
                                        <span class="fw-bold" style="font-size: 0.95rem; color: var(--on-surface);">@cat.Name</span>
                                        @if (expense.CategoryId == cat.Id)
                                        {
                                            <span class="ms-auto" style="color: @cat.ColorHex;">✓</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- PAYERS SECTION -->
                    <div class="mb-5">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <label class="editorial-label m-0">¿Quién pagó?</label>
                            <span class="badge @(IsPaymentBalanced ? "bg-success" : "bg-warning")">
                                Suma: @expense.Payments.Sum(p => p.Amount).ToString("C0") / @expense.TotalAmount.ToString("C0")
                            </span>
                        </div>
                        
                        <div class="table-responsive rounded-3 border border-secondary table-container">
                            <table class="table table-dark table-hover mb-0 align-middle">
                                <thead>
                                    <tr class="table-header-row">
                                        <th class="ps-3 border-0">Miembro</th>
                                        <th class="text-end pe-3 border-0" style="width: 150px;">Aportó ($)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in expense.Payments)
                                    {
                                        <tr>
                                            <td class="ps-3 py-3 border-0">
                                                <span style="font-weight: 500;">@p.UserName</span>
                                            </td>
                                            <td class="pe-3 py-3 border-0">
                                                <input type="number" class="editorial-input text-end py-1 px-2" style="font-size: 0.9rem; height: 36px;" @bind="p.Amount" @bind:event="oninput" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- SPLIT SECTION -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <label class="editorial-label m-0">¿Cómo se divide?</label>
                            <div class="d-flex gap-2 p-1 rounded-pill shadow-sm split-type-selector">
                                <button type="button" class="btn btn-sm rounded-pill px-3 @(expense.SelectedSplitType == SplitType.Equal ? "btn-primary" : "")" 
                                        style="@(expense.SelectedSplitType == SplitType.Equal ? "" : "color: var(--on-surface-variant);")"
                                        @onclick="() => SetSplitType(SplitType.Equal)">Equitativo</button>
                                
                                <button type="button" 
                                        class="btn btn-sm rounded-pill px-3 @(expense.SelectedSplitType == SplitType.Exact ? "btn-primary" : "")" 
                                        style="@(expense.SelectedSplitType == SplitType.Exact ? "" : "color: var(--on-surface-variant);")"
                                        @onclick='() => TrySetPremiumSplit(SplitType.Exact)'>
                                    Exacto @(!isPremium ? "👑" : "")
                                </button>

                                <button type="button" 
                                        class="btn btn-sm rounded-pill px-3 @(expense.SelectedSplitType == SplitType.Percentage ? "btn-primary" : "")" 
                                        style="@(expense.SelectedSplitType == SplitType.Percentage ? "" : "color: var(--on-surface-variant);")"
                                        @onclick='() => TrySetPremiumSplit(SplitType.Percentage)'>
                                    % @(!isPremium ? "👑" : "")
                                </button>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <p class="small m-0 split-guide-text">@(expense.SelectedSplitType == SplitType.Equal ? "Selecciona quiénes participan" : "Indica cuánto pone cada uno")</p>
                            @if (expense.SelectedSplitType == SplitType.Equal)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ToggleAllSplits" style="font-size: 0.75rem;">Seleccionar todos</button>
                            }
                            else if (expense.SelectedSplitType == SplitType.Exact)
                            {
                                <span class="badge @(IsSplitBalanced ? "bg-success" : "bg-warning")" style="font-size: 0.7rem;">
                                    Asignado: @AssignedTotal.ToString("C0") / @expense.TotalAmount.ToString("C0")
                                </span>
                            }
                            else
                            {
                                <span class="badge @(Math.Abs(TotalPercentage - 100) < 0.1m ? "bg-success" : "bg-warning")" style="font-size: 0.7rem;">
                                    Total: @TotalPercentage.ToString("0")% / 100%
                                </span>
                            }
                        </div>

                        <div class="row g-2">
                            @foreach (var s in availableSplits)
                            {
                                <div class="col-12">
                                    <div class="p-3 rounded-4 editorial-selection-card @(selectedSplits.Contains(s.UserId) ? "selected" : "") d-flex align-items-center justify-content-between cursor-pointer" 
                                         @onclick="() => ToggleSplit(s.UserId)">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="form-check m-0">
                                                <input class="form-check-input" type="checkbox" checked="@selectedSplits.Contains(s.UserId)" @onclick:stopPropagation />
                                            </div>
                                            <span class="fw-600" style="font-size: 0.95rem;">@s.UserName</span>
                                        </div>
                                        
                                        @if (expense.SelectedSplitType != SplitType.Equal && selectedSplits.Contains(s.UserId))
                                        {
                                            <div class="d-flex align-items-center gap-2" @onclick:stopPropagation>
                                                <span class="text-editorial-muted small">@(expense.SelectedSplitType == SplitType.Exact ? "$" : "%")</span>
                                                <input type="number" 
                                                       class="editorial-input py-1 px-2 text-end" 
                                                       style="width: 100px; height: 32px; font-size: 0.9rem;" 
                                                       @bind="s.Amount" 
                                                       @bind:event="oninput" />
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <button class="editorial-button-primary w-100 py-3 mt-4" disabled="@(submitting || !CanSubmit)" @onclick="HandleSubmit">
                        @if (submitting)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <span>Cargar Gasto al Círculo 🚀</span>
                        }
                    </button>
                </div>
            </div>

            <!-- Summary / Guide Column -->
            <div class="col-12 col-lg-5">
                <div class="editorial-card h-100 shadow-sm summary-card-sidebar">
                    <h3 class="brand-font mb-4" style="font-size: 1.2rem;">Resumen de División</h3>
                    
                    @if (expense.TotalAmount > 0 && selectedSplits.Any())
                    {
                        <div class="text-center mb-5 p-4 rounded-4 summary-hero-display">
                            @if (expense.SelectedSplitType == SplitType.Equal)
                            {
                                var splitVal = expense.TotalAmount / selectedSplits.Count;
                                <p class="mb-1" style="font-size: 0.8rem; color: var(--on-surface-variant);">Cada uno debe pagar:</p>
                                <h2 class="brand-font display-6 m-0" style="color: var(--primary);">@splitVal.ToString("C0")</h2>
                            }
                            else
                            {
                                <p class="mb-1" style="font-size: 0.8rem; color: var(--on-surface-variant);">Estado del Reparto:</p>
                                <h2 class="brand-font display-6 m-0" style="color: @(IsSplitBalanced ? "var(--primary)" : "var(--error)")">
                                    @(expense.SelectedSplitType == SplitType.Exact ? AssignedTotal.ToString("C0") : TotalPercentage.ToString("0") + "%")
                                </h2>
                                <p class="mt-2 mb-0" style="font-size: 0.75rem;">De @(expense.SelectedSplitType == SplitType.Exact ? expense.TotalAmount.ToString("C0") : "100%")</p>
                            }
                        </div>

                        <div class="divider mb-4 divider-line"></div>

                        <h4 class="summary-section-title">Cuentas del Gasto</h4>
                        
                        @foreach (var p in availableSplits)
                        {
                            var payment = expense.Payments.FirstOrDefault(pay => pay.UserId == p.UserId)?.Amount ?? 0;
                            decimal owed = 0;

                            if (selectedSplits.Contains(p.UserId))
                            {
                                if (expense.SelectedSplitType == SplitType.Equal) owed = expense.TotalAmount / selectedSplits.Count;
                                else if (expense.SelectedSplitType == SplitType.Exact) owed = p.Amount;
                                else owed = (p.Amount / 100m) * expense.TotalAmount;
                            }

                            var diff = payment - owed;
                            
                            <div class="d-flex justify-content-between align-items-center mb-3 @(selectedSplits.Contains(p.UserId) ? "" : "opacity-50")">
                                <span style="font-size: 0.9rem;">@p.UserName</span>
                                <div class="text-end">
                                    <span class="fw-bold" style="color: @(diff >= 0 ? "var(--primary)" : "#ff6b6b");">
                                        @(diff > 0 ? "+" : "")@diff.ToString("C2")
                                    </span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 opacity-50">
                            <p>Ingresa un monto y selecciona participantes para ver cálculos.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    @if (showPaywall)
    {
        <PremiumPaywall Title="@paywallTitle" OnClose="() => showPaywall = false" OnUpgrade="HandleUpgrade" />
    }
</div>

@code {
    private CreateExpenseModel expense = new() { Title = "", TotalAmount = 0 };
    private List<GroupSummaryViewModel> userGroups = new();
    private List<CategoryDto> categories = new();
    private List<GroupMemberResponse> currentGroupMembers = new();
    private HashSet<string> selectedSplits = new();
    private List<ExpensePaymentViewModel> availableSplits = new(); // Used just for the list
    private bool loadingGroups = true;
    private bool submitting = false;
    private bool isPremium = false;
    private bool showPaywall = false;
    private string paywallTitle = "Repartos Pro";

    private void TrySetPremiumSplit(SplitType type)
    {
        if (isPremium)
        {
            SetSplitType(type);
        }
        else
        {
            paywallTitle = "Repartos Pro";
            showPaywall = true;
        }
    }

    private void HandleUpgrade()
    {
        ToastService.ShowToast("Próximamente: Integración con suscripciones 💳", ToastLevel.Info);
    }

    private bool isCategoryDropdownOpen = false;
    private CategoryDto? SelectedCategory => categories.FirstOrDefault(c => c.Id == expense.CategoryId);

    private void ToggleCategoryDropdown()
    {
        isCategoryDropdownOpen = !isCategoryDropdownOpen;
    }

    private void SelectCategory(Guid categoryId)
    {
        expense.CategoryId = categoryId;
        isCategoryDropdownOpen = false;
    }

    private void CloseDropdowns()
    {
        if (isCategoryDropdownOpen)
        {
            isCategoryDropdownOpen = false;
        }
    }

    [Parameter]
    public Guid? ExpenseId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? GroupId { get; set; }

    private string _selectedGroupId = "";
    private string SelectedGroupId 
    { 
        get => _selectedGroupId; 
        set {
            if (_selectedGroupId != value) {
                _selectedGroupId = value;
                _ = LoadGroupMembers();
            }
        } 
    }

    private decimal AssignedTotal => availableSplits.Where(s => selectedSplits.Contains(s.UserId)).Sum(s => s.Amount);
    private decimal TotalPercentage => availableSplits.Where(s => selectedSplits.Contains(s.UserId)).Sum(s => s.Amount);

    private bool IsSplitBalanced {
        get {
            if (expense.SelectedSplitType == SplitType.Equal) return true;
            if (expense.SelectedSplitType == SplitType.Exact) return Math.Abs(AssignedTotal - expense.TotalAmount) < 0.01m;
            if (expense.SelectedSplitType == SplitType.Percentage) return Math.Abs(TotalPercentage - 100) < 0.1m;
            return false;
        }
    }

    private bool IsPaymentBalanced => Math.Abs(expense.Payments.Sum(p => p.Amount) - expense.TotalAmount) < 0.01m;
    private bool CanSubmit => IsPaymentBalanced && IsSplitBalanced && expense.TotalAmount > 0 && !string.IsNullOrWhiteSpace(expense.Title) && selectedSplits.Any();

    private void SetSplitType(SplitType type)
    {
        expense.SelectedSplitType = type;
        if (type == SplitType.Equal)
        {
            // Reset amounts
            foreach (var s in availableSplits) s.Amount = 0;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isPremium = authState.User.IsInRole("PremiumUser");

        userGroups = await ExpenseService.GetUserGroupsAsync();
        categories = await ExpenseService.GetCategoriesAsync();
        
        if (ExpenseId.HasValue)
        {
            var detail = await ExpenseService.GetExpenseDetailsAsync(ExpenseId.Value);
            if (detail != null)
            {
                expense.Title = detail.Description;
                expense.TotalAmount = detail.TotalAmount;
                expense.CategoryId = categories.FirstOrDefault(c => c.IconIdentifier == detail.CategoryIcon)?.Id;
                
                // Note: We need GroupId to load members. We search it by GroupName for now 
                // if the API doesn't return GroupId in details. 
                // Wait, ExpenseDetailViewModel might need GroupId?
                // Or we find it in userGroups.
                var group = userGroups.FirstOrDefault(g => g.Name == detail.GroupName);
                if (group != null) SelectedGroupId = group.Id;

                // We load members first via SelectedGroupId (it triggers LoadGroupMembers)
                // BUT LoadGroupMembers initializes Payments to 0. 
                // We must WAIT for it or do it manually.
                await LoadGroupMembers();

                // Now fill payments from detail
                foreach (var p in expense.Payments)
                {
                    var detailPayment = detail.Payments.FirstOrDefault(dp => dp.UserName == p.UserName);
                    if (detailPayment != null) p.Amount = detailPayment.Amount;
                }

                // Fill splits and types
                expense.SelectedSplitType = detail.SplitType;
                selectedSplits.Clear();
                foreach (var ds in detail.Splits)
                {
                    var member = currentGroupMembers.FirstOrDefault(m => m.FullName == ds.UserName);
                    if (member != null) 
                    {
                        selectedSplits.Add(member.UserId);
                        // If it was exact or percentage, restore the value
                        var splitInput = availableSplits.FirstOrDefault(s => s.UserId == member.UserId);
                        if (splitInput != null) splitInput.Amount = ds.AmountOwed;
                    }
                }
            }
        }
        else if (!string.IsNullOrEmpty(GroupId) && userGroups.Any(g => g.Id == GroupId))
        {
            SelectedGroupId = GroupId;
        }
        else if (userGroups.Any())
        {
            SelectedGroupId = userGroups.First().Id;
        }
        loadingGroups = false;
    }

    private async Task LoadGroupMembers()
    {
        if (string.IsNullOrEmpty(SelectedGroupId)) return;
        
        currentGroupMembers = await ExpenseService.GetGroupMembersAsync(SelectedGroupId);
        
        // Initialize Payments list
        expense.Payments = currentGroupMembers.Select(m => new ExpensePaymentViewModel {
            UserId = m.UserId,
            UserName = m.FullName,
            Amount = 0
        }).ToList();

        // Initialize Split selection
        availableSplits = currentGroupMembers.Select(m => new ExpensePaymentViewModel {
            UserId = m.UserId,
            UserName = m.FullName
        }).ToList();
        
        selectedSplits = new HashSet<string>(currentGroupMembers.Select(m => m.UserId));
        
        expense.GroupId = SelectedGroupId;

        // Auto-assign self as payer if possible
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var selfId = authState.User.Claims.FirstOrDefault(c => c.Type == "sub" || c.Type == ClaimTypes.NameIdentifier)?.Value;
        
        if (selfId != null && expense.TotalAmount > 0) {
            var selfPayment = expense.Payments.FirstOrDefault(p => p.UserId == selfId);
            if (selfPayment != null) selfPayment.Amount = expense.TotalAmount;
        }

        StateHasChanged();
    }

    private void DistributeEquallyIfFirstTime()
    {
        // Simple logic: if only one payer currently has all, or they are all 0, assign to first?
        // Actually, we'll let user put it or auto-assign to self
    }

    private void ToggleSplit(string userId)
    {
        if (selectedSplits.Contains(userId)) selectedSplits.Remove(userId);
        else selectedSplits.Add(userId);
    }

    private void ToggleAllSplits()
    {
        if (selectedSplits.Count == currentGroupMembers.Count) selectedSplits.Clear();
        else selectedSplits = new HashSet<string>(currentGroupMembers.Select(m => m.UserId));
    }

    private void GoBack() => Navigation.NavigateTo("/");

    private async Task HandleSubmit()
    {
        if (!CanSubmit) return;

        submitting = true;
        
        // Prepare Splits based on type
        if (expense.SelectedSplitType == SplitType.Equal)
        {
            var splitVal = Math.Round(expense.TotalAmount / selectedSplits.Count, 2);
            expense.Splits = selectedSplits.Select(uid => new ExpenseSplitViewModel {
                UserId = uid,
                Amount = splitVal,
                SplitType = SplitType.Equal
            }).ToList();
        }
        else
        {
            expense.Splits = availableSplits
                .Where(s => selectedSplits.Contains(s.UserId))
                .Select(s => new ExpenseSplitViewModel {
                    UserId = s.UserId,
                    Amount = s.Amount,
                    SplitType = expense.SelectedSplitType
                }).ToList();
        }

        // Keep only non-zero payments to clean the request
        var finalPayments = expense.Payments.Where(p => p.Amount > 0).ToList();
        var originalPayments = expense.Payments;
        expense.Payments = finalPayments;

        bool success;
        if (ExpenseId.HasValue)
        {
            success = await ExpenseService.UpdateExpenseAsync(ExpenseId.Value, expense);
        }
        else
        {
            success = await ExpenseService.CreateExpenseAsync(expense);
        }
        submitting = false;

        if (success)
        {
            ToastService.ShowToast(ExpenseId.HasValue ? "¡Gasto actualizado! ✏️" : "¡Gasto multi-pagador registrado! 🚀", ToastLevel.Success);
            await Task.Delay(500); 
            Navigation.NavigateTo("/");
        }
        else
        {
            expense.Payments = originalPayments; // Restore for UI if failed
            ToastService.ShowToast("Error al procesar el gasto", ToastLevel.Error);
        }
    }
}
