@page "/server-error"
@layout SplitMoney.Client.Components.Layout.MainLayout

<div class="container d-flex align-items-center justify-content-center min-vh-80 px-4">
    <div class="editorial-card text-center shadow-lg border-danger py-6 px-4" style="max-width: 500px; background: linear-gradient(135deg, var(--surface-container-low), #2a1b1b); border: 2px solid #ef4444; opacity: 0.95;">
        <div class="mb-5 mx-auto" style="width: 120px; height: 120px; background: rgba(239, 68, 68, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 4rem; box-shadow: 0 0 40px rgba(239, 68, 68, 0.2); animation: shake 0.5s infinite; animation-play-state: paused;" id="errorIcon">
            🔌
        </div>
        <h1 class="brand-font mb-3" style="font-size: 2.2rem; color: #ef4444;">Error en el Servidor</h1>
        <p class="mx-auto mb-5" style="color: var(--on-surface-variant); line-height: 1.7; font-size: 1.1rem; max-width: 380px;">
            Hubo un problema de conexión con la API de SplitMoney. Reintenta ahora o revisa tu conexión a Internet para continuar.
        </p>
        <div class="d-grid gap-3">
            <button class="editorial-button-primary d-inline-flex align-items-center justify-content-center gap-2" style="background: linear-gradient(135deg, #ef4444, #93000a);" @onclick="GoBack">
                <span>Reintentar Conexión</span>
                <span style="font-size: 1.25rem;">🔄</span>
            </button>
            <a href="/" class="btn rounded-pill border-outline py-3" style="color: var(--on-surface-variant); font-weight: 500;">Volver al Home</a>
        </div>
    </div>
</div>

@code {
    [Inject] NavigationManager Navigation { get; set; } = null!;
    private void GoBack() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
}

<style>
    @@keyframes shake {
        0% { transform: translate(1px, 1px) rotate(0deg); }
        10% { transform: translate(-1px, -2px) rotate(-1deg); }
        20% { transform: translate(-3px, 0px) rotate(1deg); }
        30% { transform: translate(3px, 2px) rotate(0deg); }
        40% { transform: translate(1px, -1px) rotate(1deg); }
        50% { transform: translate(-1px, 2px) rotate(-1deg); }
    }
    #errorIcon:hover { animation-play-state: running; }
</style>
