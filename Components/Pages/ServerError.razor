@page "/server-error"
@layout SplitMoney.Client.Components.Layout.MainLayout

<div class="container d-flex align-items-center justify-content-center min-vh-80 px-4">
    <div class="editorial-card text-center shadow-lg border-danger py-6 px-4 server-error-card">
        <div class="mb-5 mx-auto server-error-icon-box">
            🔌
        </div>
        <h1 class="brand-font mb-3 server-error-title">Error en el Servidor</h1>
        <p class="mx-auto mb-5 server-error-text">
            Hubo un problema de conexión con la API de SplitMoney. Reintenta ahora o revisa tu conexión a Internet para continuar.
        </p>
        <div class="d-grid gap-3">
            <button class="editorial-button-primary d-inline-flex align-items-center justify-content-center gap-2 retry-button" @onclick="GoBack">
                <span>Reintentar Conexión</span>
                <span style="font-size: 1.25rem;">🔄</span>
            </button>
            <a href="/" class="btn rounded-pill border-outline py-3 home-link-btn">Volver al Home</a>
        </div>
    </div>
</div>
