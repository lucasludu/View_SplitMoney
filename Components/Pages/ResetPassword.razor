@page "/reset-password"
@using SplitMoney.Client.Services
@using SplitMoney.Client.Models
@layout EmptyLayout

<div class="auth-page">
    <div class="auth-container fade-in">
        <div class="auth-card">
            <div class="text-center mb-4">
                <div class="auth-logo mb-3">
                    <span class="material-symbols-rounded">password</span>
                </div>
                <h2 class="brand-font">Nueva Contraseña</h2>
                <p class="text-muted">Ingresa el código que recibiste por correo y elige tu nueva clave.</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 mb-4 animate-shake">
                    <span class="material-symbols-rounded">warning</span>
                    <span>@errorMessage</span>
                </div>
            }

            <EditForm Model="resetModel" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <div class="input-group-modern">
                        <span class="material-symbols-rounded input-icon">mail</span>
                        <InputText @bind-Value="resetModel.Email" class="modern-input" placeholder="Tu correo electrónico" />
                    </div>
                    <ValidationMessage For="@(() => resetModel.Email)" class="small text-danger mt-1 px-2" />
                </div>

                <div class="mb-3">
                    <div class="input-group-modern">
                        <span class="material-symbols-rounded input-icon">key</span>
                        <InputText @bind-Value="resetModel.Token" class="modern-input" placeholder="Código de recuperación" />
                    </div>
                    <ValidationMessage For="@(() => resetModel.Token)" class="small text-danger mt-1 px-2" />
                </div>

                <div class="mb-3">
                    <div class="input-group-modern">
                        <span class="material-symbols-rounded input-icon">lock</span>
                        <InputText @bind-Value="resetModel.Password" type="password" class="modern-input" placeholder="Nueva contraseña" />
                    </div>
                    <ValidationMessage For="@(() => resetModel.Password)" class="small text-danger mt-1 px-2" />
                </div>

                <div class="mb-4">
                    <div class="input-group-modern">
                        <span class="material-symbols-rounded input-icon">lock_reset</span>
                        <InputText @bind-Value="resetModel.ConfirmPassword" type="password" class="modern-input" placeholder="Confirmar contraseña" />
                    </div>
                    <ValidationMessage For="@(() => resetModel.ConfirmPassword)" class="small text-danger mt-1 px-2" />
                </div>

                <button type="submit" class="btn-auth w-100 mb-4" disabled="@loading">
                    @if (loading)
                    {
                        <div class="spinner-border spinner-border-sm"></div>
                    }
                    else
                    {
                        <span>Restablecer Contraseña</span>
                        <span class="material-symbols-rounded">check_circle</span>
                    }
                </button>
            </EditForm>

            <div class="text-center">
                <a href="/login" class="back-link d-inline-flex align-items-center gap-2 text-decoration-none">
                    <span class="material-symbols-rounded">arrow_back</span>
                    <span>Cancelar y volver</span>
                </a>
            </div>
        </div>
    </div>
</div>
