@page "/forgot-password"
@using SplitMoney.Client.Services
@using SplitMoney.Client.Models
@layout EmptyLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IToastService ToastService

<div class="auth-page">
    <div class="auth-container fade-in">
        <div class="auth-card">
            <div class="text-center mb-4">
                <div class="auth-logo mb-3">
                    <span class="material-symbols-rounded">lock_reset</span>
                </div>
                <h2 class="brand-font">Recuperar Contraseña</h2>
                <p class="text-muted">Ingresa tu correo y te enviaremos los pasos para restablecer tu cuenta.</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 mb-4 animate-shake">
                    <span class="material-symbols-rounded">warning</span>
                    <span>@errorMessage</span>
                </div>
            }

            @if (emailSent)
            {
                <div class="success-state text-center py-4 fade-in">
                    <div class="success-icon mb-4">
                        <span class="material-symbols-rounded">mark_email_read</span>
                    </div>
                    <h4 class="fw-bold mb-3">¡Correo Enviado!</h4>
                    <p class="text-muted mb-4">Revisa tu bandeja de entrada. Te hemos enviado un código para restablecer tu contraseña.</p>
                    <button class="btn btn-primary w-100" @onclick='() => Navigation.NavigateTo("/reset-password")'>
                        Ingresar Código
                    </button>
                    <div class="mt-3">
                        <button class="btn btn-link text-decoration-none small" @onclick='() => emailSent = false'>
                            Reintentar con otro correo
                        </button>
                    </div>
                </div>
            }
            else
            {
                <EditForm Model="forgotModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    <div class="mb-4">
                        <div class="input-group-modern">
                            <span class="material-symbols-rounded input-icon">mail</span>
                            <InputText @bind-Value="forgotModel.Email" class="modern-input" placeholder="Correo electrónico" />
                        </div>
                        <ValidationMessage For="@(() => forgotModel.Email)" class="small text-danger mt-1 px-2" />
                    </div>

                    <button type="submit" class="btn-auth w-100 mb-4" disabled="@loading">
                        @if (loading)
                        {
                            <div class="spinner-border spinner-border-sm"></div>
                        }
                        else
                        {
                            <span>Enviar Instrucciones</span>
                            <span class="material-symbols-rounded">send</span>
                        }
                    </button>
                </EditForm>
            }

            <div class="text-center">
                <a href="/login" class="back-link d-inline-flex align-items-center gap-2 text-decoration-none">
                    <span class="material-symbols-rounded">arrow_back</span>
                    <span>Volver al inicio de sesión</span>
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    private ForgotPasswordRequest forgotModel = new();
    private bool loading = false;
    private string errorMessage = "";
    private bool emailSent = false;

    private async Task HandleSubmit()
    {
        loading = true;
        errorMessage = "";
        
        var result = await AuthService.ForgotPassword(forgotModel.Email);
        
        if (result.Succeeded)
        {
            emailSent = true;
            ToastService.ShowToast("¡Correo enviado con éxito! 📧", ToastLevel.Success);
        }
        else
        {
            errorMessage = result.Message ?? "No pudimos procesar tu solicitud en este momento.";
        }
        
        loading = false;
    }
}
