@page "/profile"
@using SplitMoney.Client.Services
@using SplitMoney.Client.Models
@using System.Security.Claims
@attribute [Authorize]
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IModalService ModalService
@inject AuthenticationStateProvider AuthStateProvider
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<div class="profile-wrapper">
    <div class="container-fluid px-3 py-4 p-md-5">
        
        <!-- Header -->
        <div class="d-flex align-items-center mb-5 gap-3 fade-in">
            <button class="back-btn-modern" @onclick="GoBack">
                <span class="material-symbols-rounded">arrow_back</span>
            </button>
            <div>
                <p class="header-tag mb-1">Ajustes</p>
                <h1 class="brand-font m-0">Mi Perfil</h1>
            </div>
            <button class="logout-btn ms-auto" @onclick="HandleLogout">
                <span class="material-symbols-rounded">logout</span>
                <span class="d-none d-md-inline">Cerrar Sesión</span>
            </button>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        else
        {
            <div class="row g-4 justify-content-center">
                <div class="col-12 col-lg-8">
                    <div class="premium-card fade-in-up">
                        
                        <!-- Avatar Section -->
                        <div class="profile-hero mb-5">
                            <div class="avatar-container">
                                <div class="avatar-large">
                                    @(userProfile.FirstName.Substring(0, 1).ToUpper())
                                </div>
                                @if (userProfile.Role == "PremiumUser")
                                {
                                    <div class="premium-badge-float">
                                        <span class="material-symbols-rounded">verified</span>
                                    </div>
                                }
                            </div>
                            <div class="mt-3">
                                <h2 class="brand-font m-0">@userProfile.FirstName @userProfile.LastName</h2>
                                <p class="user-role-text">@(userProfile.Role == "PremiumUser" ? "Miembro Premium" : "Usuario Estándar")</p>
                            </div>
                        </div>

                        <form @onsubmit="HandleUpdate">
                            <div class="section-box mb-5">
                                <h3 class="section-subtitle mb-4">Información Personal</h3>
                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <div class="input-group-modern">
                                            <span class="material-symbols-rounded input-icon">person</span>
                                            <input type="text" class="modern-input" placeholder="Nombre" @bind="userProfile.FirstName" required />
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="input-group-modern">
                                            <span class="material-symbols-rounded input-icon">badge</span>
                                            <input type="text" class="modern-input" placeholder="Apellido" @bind="userProfile.LastName" required />
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="input-group-modern disabled-input">
                                            <span class="material-symbols-rounded input-icon">mail</span>
                                            <input type="email" class="modern-input" @bind="userProfile.Email" readonly />
                                        </div>
                                        <p class="input-hint mt-2">El correo electrónico no se puede cambiar por seguridad.</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Subscription Section -->
                            <div class="section-box mb-5">
                                <h3 class="section-subtitle mb-4">Suscripción y Plan</h3>
                                <div class="plan-card @(IsUserPremium ? "gold-theme" : "standard-theme")">
                                    <div class="d-flex align-items-center gap-4">
                                        <div class="plan-icon-box">
                                            <span class="material-symbols-rounded">@(IsUserPremium ? "workspace_premium" : "person_outline")</span>
                                        </div>
                                        <div class="flex-grow-1">
                                            <h4 class="m-0">Plan @(IsUserPremium ? "Premium" : "Básico")</h4>
                                            <p class="m-0 opacity-60">@(IsUserPremium ? "Acceso total e ilimitado." : "Funciones estándar activas.")</p>
                                        </div>
                                        @if (!IsUserPremium)
                                        {
                                            <button type="button" class="btn-upgrade" @onclick='() => Navigation.NavigateTo("/premium")'>Mejorar ✨</button>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="action-footer mt-5">
                                <button type="submit" class="btn-submit-premium w-100 py-3" disabled="@submitting">
                                    @if (submitting)
                                    {
                                        <div class="spinner"></div>
                                    }
                                    else
                                    {
                                        <span>Guardar Cambios</span>
                                        <span class="material-symbols-rounded">save</span>
                                    }
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private UserDto userProfile = new();
    private bool isLoading = true;
    private bool submitting = false;
    private bool isDeleting = false;
    private bool isSimulatedPremium = false;
    private bool IsUserPremium => 
        (userProfile.Role?.Equals("PremiumUser", StringComparison.OrdinalIgnoreCase) ?? false) || 
        (userProfile.Role?.Equals("Premium", StringComparison.OrdinalIgnoreCase) ?? false) ||
        isSimulatedPremium;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            isSimulatedPremium = (await LocalStorage.GetItemAsync<bool>("is_simulated_premium")) || authState.User.IsInRole("PremiumUser");

            var response = await AuthService.GetProfile();
            if (response != null && response.Succeeded && response.Data != null)
            {
                userProfile = response.Data;
            }
            else Navigation.NavigateTo("/");
        }
        catch (Exception)
        {
            if (isSimulatedPremium) userProfile.Role = "PremiumUser";
            isLoading = false;
        }
        finally { isLoading = false; }
    }

    private async Task HandleUpdate()
    {
        submitting = true;
        try
        {
            var response = await AuthService.UpdateProfile(userProfile);
            if (response != null && response.Succeeded) ModalService.ShowModal("¡Perfil Actualizado!", "Tus cambios han sido guardados correctamente.", ModalType.Success);
            else ModalService.ShowModal("Error", response?.Message ?? "No se pudo actualizar.", ModalType.Error);
        }
        finally { submitting = false; }
    }

    private async Task HandleLogout()
    {
        await AuthService.Logout();
        Navigation.NavigateTo("/login", true);
    }

    private void GoBack() => Navigation.NavigateTo("/");
}
