@page "/profile"
@using SplitMoney.Client.Services
@using SplitMoney.Client.Models
@using System.Security.Claims
@attribute [Authorize]

<div class="profile-wrapper">
    <div class="container py-4 py-md-5">
        
        <!-- Header Section -->
        <div class="profile-header fade-in mb-5">
                <div class="d-flex align-items-center gap-3">
                    <button class="back-btn-modern" @onclick="GoBack" title="Volver">
                        <span class="material-symbols-rounded">arrow_back</span>
                    </button>
                    <div>
                        <p class="header-tag m-0">Ajustes</p>
                        <h1 class="brand-font m-0 h2-responsive">Mi Perfil</h1>
                    </div>
                </div>
        </div>

        @if (isLoading)
        {
            <div class="loading-state py-5 text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        }
        else
        {
            <div class="row justify-content-center g-4">
                <div class="col-12 col-lg-8 col-xl-7">
                    <div class="profile-card fade-in-up">
                        
                        <!-- Avatar & Identity Section -->
                        <div class="profile-hero mb-5">
                            <div class="avatar-outer-ring">
                                <div class="avatar-container">
                                    <UserAvatar Name="@userProfile.FirstName" Class="editorial-avatar-hero" />
                                    @if (userProfile.Role == "PremiumUser" || IsUserPremium)
                                    {
                                        <div class="premium-badge-float" title="Usuario Premium">
                                            <span class="material-symbols-rounded">verified</span>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="mt-4">
                                <h2 class="brand-font m-0 h3">@userProfile.FirstName @userProfile.LastName</h2>
                                <div class="role-badge-container mt-2">
                                    <span class="user-role-badge @(IsUserPremium ? "premium" : "standard")">
                                        @(IsUserPremium ? "Miembro Premium" : "Usuario Estándar")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <EditForm Model="userProfile" OnValidSubmit="HandleUpdateProfile">
                            <DataAnnotationsValidator />
                            
                            <!-- Personal Information -->
                            <div class="section-container mb-5">
                                <div class="d-flex align-items-center gap-2 mb-4">
                                    <span class="material-symbols-rounded section-icon">account_circle</span>
                                    <h3 class="section-title m-0">Información Personal</h3>
                                </div>
                                
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="premium-input-group">
                                            <label class="premium-input-label">Nombre</label>
                                            <div class="premium-input-wrapper">
                                                <span class="material-symbols-rounded premium-input-icon">person</span>
                                                <InputText class="premium-input" placeholder="Tu nombre" @bind-Value="userProfile.FirstName" />
                                            </div>
                                            <ValidationMessage For="@(() => userProfile.FirstName)" class="error-msg" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="premium-input-group">
                                            <label class="premium-input-label">Apellido</label>
                                            <div class="premium-input-wrapper">
                                                <span class="material-symbols-rounded premium-input-icon">badge</span>
                                                <InputText class="premium-input" placeholder="Tu apellido" @bind-Value="userProfile.LastName" />
                                            </div>
                                            <ValidationMessage For="@(() => userProfile.LastName)" class="error-msg" />
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="premium-input-group">
                                            <label class="premium-input-label">Correo Electrónico</label>
                                            <div class="premium-input-wrapper readonly">
                                                <span class="material-symbols-rounded premium-input-icon">mail</span>
                                                <input type="email" class="premium-input" value="@userProfile.Email" readonly />
                                            </div>
                                            <p class="input-hint mt-2">
                                                <span class="material-symbols-rounded" style="font-size: 1rem; vertical-align: middle;">info</span>
                                                El correo no puede ser modificado.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Plan Section -->
                            <div class="section-container mb-5">
                                <div class="d-flex align-items-center gap-2 mb-4">
                                    <span class="material-symbols-rounded section-icon">star</span>
                                    <h3 class="section-title m-0">Suscripción y Plan</h3>
                                </div>
                                
                                <div class="plan-display-card @(IsUserPremium ? "premium-active" : "standard-active")">
                                    <div class="plan-card-content">
                                        <div class="plan-icon">
                                            <span class="material-symbols-rounded">@(IsUserPremium ? "workspace_premium" : "person_outline")</span>
                                        </div>
                                        <div class="plan-info">
                                            <h4 class="m-0">Plan @(IsUserPremium ? "Premium" : "Básico")</h4>
                                            <p class="m-0 opacity-70 small">@(IsUserPremium ? "Disfrutando de todas las funciones ilimitadas." : "Acceso a funciones esenciales.")</p>
                                        </div>
                                        @if (!IsUserPremium)
                                        {
                                            <button type="button" class="btn-upgrade-minimal" @onclick='() => Navigation.NavigateTo("/premium")'>
                                                Mejorar ✨
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="profile-actions pt-4">
                                <button type="submit" class="btn-save-profile" disabled="@submitting">
                                    @if (submitting)
                                    {
                                        <div class="spinner-white"></div>
                                        <span>Guardando...</span>
                                    }
                                    else
                                    {
                                        <span>Guardar Cambios</span>
                                        <span class="material-symbols-rounded">done_all</span>
                                    }
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
