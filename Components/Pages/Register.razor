@page "/register"
@layout SplitMoney.Client.Components.Layout.EmptyLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="register-page-wrapper d-flex align-items-center justify-content-center px-4">
    <div class="editorial-card register-box shadow-lg">
        <div class="text-center mb-5">
            <h1 class="brand-font register-title">Crea tu Cuenta</h1>
            <p class="register-subtitle">Únete a la mejor forma de dividir gastos.</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mb-4 register-error-alert">
                <p class="mb-1 fw-bold">Hubo un problema:</p>
                @if (errors.Any())
                {
                    <ul class="error-list">
                        @foreach (var error in errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="m-0">@errorMessage</p>
                }
            </div>
        }

        <EditForm Model="registerModel" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />

            <div class="row g-3 mb-4">
                <div class="col-6">
                    <div class="editorial-input-group">
                        <label class="editorial-label">Nombre</label>
                        <div class="input-wrapper">
                            <span class="input-icon">👤</span>
                            <InputText @bind-Value="registerModel.FirstName" class="editorial-input w-100" placeholder="Lucas" />
                        </div>
                        <ValidationMessage For="@(() => registerModel.FirstName)" class="small text-danger mt-1" />
                    </div>
                </div>
                <div class="col-6">
                    <div class="editorial-input-group">
                        <label class="editorial-label">Apellido</label>
                        <div class="input-wrapper">
                            <span class="input-icon">🆔</span>
                            <InputText @bind-Value="registerModel.LastName" class="editorial-input w-100" placeholder="Ludu" />
                        </div>
                        <ValidationMessage For="@(() => registerModel.LastName)" class="small text-danger mt-1" />
                    </div>
                </div>
            </div>

            <div class="editorial-input-group mb-4">
                <label class="editorial-label">Email</label>
                <div class="input-wrapper">
                    <span class="input-icon">✉️</span>
                    <InputText @bind-Value="registerModel.Email" class="editorial-input w-100" placeholder="nombre@ejemplo.com" />
                </div>
                <ValidationMessage For="@(() => registerModel.Email)" class="small text-danger mt-1" />
            </div>

            <div class="editorial-input-group mb-4">
                <label class="editorial-label">Contraseña</label>
                <div class="input-wrapper">
                    <span class="input-icon">🔑</span>
                    <InputText @bind-Value="registerModel.Password" type="@(showPassword ? "text" : "password")" class="editorial-input w-100" placeholder="••••••••" />
                    <button type="button" class="password-toggle-btn" @onclick="() => showPassword = !showPassword">
                        @(showPassword ? "👁️" : "🙈")
                    </button>
                </div>
                <ValidationMessage For="@(() => registerModel.Password)" class="small text-danger mt-1" />
            </div>

            <div class="editorial-input-group mb-5">
                <label class="editorial-label">Confirmar Contraseña</label>
                <div class="input-wrapper">
                    <span class="input-icon">✅</span>
                    <InputText @bind-Value="registerModel.ConfirmPassword" type="@(showPassword ? "text" : "password")" class="editorial-input w-100" placeholder="••••••••" />
                    <button type="button" class="password-toggle-btn" @onclick="() => showPassword = !showPassword">
                        @(showPassword ? "👁️" : "🙈")
                    </button>
                </div>
                <ValidationMessage For="@(() => registerModel.ConfirmPassword)" class="small text-danger mt-1" />
            </div>

            <button type="submit" class="editorial-button-primary w-100 py-3 shadow-lg" disabled="@loading">
                @if (loading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <span>Registrarse Ahora ✨</span>
                }
            </button>

            <div class="text-center mt-5">
                <p class="footer-text">
                    ¿Ya tienes cuenta? <a href="/login" class="text-primary text-decoration-none fw-bold ms-1">Inicia sesión</a>
                </p>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private RegisterUserRequest registerModel = new RegisterUserRequest();
    private string? errorMessage;
    private List<string> errors = new List<string>();
    private bool loading = false;
    private bool showPassword = false;

    private async Task HandleRegister()
    {
        loading = true;
        errorMessage = null;
        errors.Clear();

        try
        {
            var result = await AuthService.Register(registerModel);

            if (result.Succeeded)
            {
                Navigation.NavigateTo("/login");
            }
            else
            {
                errorMessage = result.Message ?? "Registration failed.";
                if (result.Errors != null)
                {
                    errors = result.Errors;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message} {(ex.InnerException != null ? " -> " + ex.InnerException.Message : "")}";
        }
        finally
        {
            loading = false;
        }
    }
}
