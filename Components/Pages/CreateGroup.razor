@page "/groups/new"
@using SplitMoney.Client.Services
@using SplitMoney.Client.Models.ViewModels
@using System.Security.Claims
@attribute [Authorize]
@inject NavigationManager Navigation
@inject IExpenseService ExpenseService
@inject IToastService ToastService
@inject IModalService ModalService
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider

<div class="container-fluid px-3 py-4 p-md-5 create-group-container">
    
    <!-- Header -->
    <div class="d-flex align-items-center mb-5 gap-3">
        <button class="btn rounded-circle back-button-circle" @onclick="GoBack">
            <span class="back-icon">⬅️</span>
        </button>
        <div>
            <p class="mb-1 header-label">Nuevos Círculos</p>
            <h1 class="brand-font m-0 h2-responsive">Crear Nuevo Grupo</h1>
        </div>
    </div>

    <div class="editorial-card shadow-lg p-4 p-md-5">
        <form @onsubmit="HandleSubmit">
            <!-- Group Name -->
            <div class="editorial-input-group mb-4">
                <label class="editorial-label">Nombre del Grupo</label>
                <input type="text" class="editorial-input brand-font group-name-input" placeholder="Ej: Viaje a Brasil 🇧🇷" @bind="groupName" required />
            </div>

            <!-- Description -->
            <div class="editorial-input-group mb-5">
                <label class="editorial-label">Descripción (Opcional)</label>
                <input type="text" class="editorial-input" placeholder="¿De qué trata este grupo?" @bind="description" />
            </div>

            <!-- Add Members Section -->
            <div class="mb-5">
                <label class="editorial-label d-flex justify-content-between align-items-center mb-3">
                    Invitados
                    <span class="badge bg-primary rounded-pill">@(members.Count) personas</span>
                </label>
                
                <div class="d-flex gap-2 mb-4">
                    <div style="flex-grow: 1; position: relative;">
                        <input type="email" class="editorial-input" placeholder="amigo@email.com" @bind="newMemberEmail" @onkeydown="@(e => { if(e.Key == "Enter") AddMember(); })" />
                        <span style="position: absolute; right: 1rem; top: 1rem; opacity: 0.5;">✉️</span>
                    </div>
                    <button type="button" class="editorial-button-primary add-member-btn" @onclick="AddMember">
                        <span>Añadir</span>
                    </button>
                </div>

                <div class="members-list">
                    @foreach (var m in members)
                    {
                        <div class="d-flex justify-content-between align-items-center p-3 mb-2 rounded-3 member-item-card">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center member-avatar-circle">
                                    @m.Email.Substring(0, 1).ToUpper()
                                </div>
                                <span class="member-email-text">@m.Email</span>
                                @if (m.Email == userEmail)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary me-badge">Tú</span>
                                }
                            </div>
                            @if (m.Email != userEmail)
                            {
                                <button type="button" class="btn btn-link btn-sm text-danger text-decoration-none" @onclick="() => members.Remove(m)">Quitar</button>
                            }
                        </div>
                    }
                </div>
            </div>

            <button type="submit" class="editorial-button-primary mt-4 py-3" disabled="@submitting">
                @if (submitting)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                else
                {
                    <span>Crear Grupo y Empezar 🌐</span>
                }
            </button>
        </form>
    </div>
</div>

@code {
    private string groupName = string.Empty;
    private string description = string.Empty;
    private string newMemberEmail = string.Empty;
    private string userEmail = string.Empty;
    private List<MemberSpendRecordViewModel> members = new();
    private bool submitting = false;
    private bool isPremium = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        
        // Cargar estado premium real o simulado
        var isRealPremium = authState.User.IsInRole("PremiumUser");
        var isSimulatedPremium = await LocalStorage.GetItemAsync<bool>("is_simulated_premium");
        isPremium = isRealPremium || isSimulatedPremium;

        userEmail = authState.User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value ?? "";
        
        if (!string.IsNullOrEmpty(userEmail))
        {
            members.Add(new MemberSpendRecordViewModel { Email = userEmail, AmountSpent = 0 });
        }
    }

    private void AddMember()
    {
        if (string.IsNullOrWhiteSpace(newMemberEmail) || !newMemberEmail.Contains("@") || members.Any(m => m.Email == newMemberEmail))
        {
            return;
        }

        // Limit check for non-premium users
        if (!isPremium && members.Count >= 5)
        {
            ModalService.ShowModal(
                "Límite de Invitados", 
                "Has alcanzado el límite de 5 personas por grupo para usuarios estándar. Desbloquea el plan Premium para crear círculos ilimitados y sin límites de invitados.", 
                ModalType.Warning
            );
            return;
        }

        members.Add(new MemberSpendRecordViewModel { Email = newMemberEmail, AmountSpent = 0 });
        newMemberEmail = string.Empty;
    }

    private void GoBack() => Navigation.NavigateTo("/groups");

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(groupName)) return;

        submitting = true;
        // Enviamos los miembros con monto 0, ya que así lo maneja el backend ahora de forma limpia
        var success = await ExpenseService.CreateGroupAsync(groupName, members);
        submitting = false;

        if (success)
        {
            ModalService.ShowModal("¡Círculo Creado!", $"El grupo '{groupName}' ha sido registrado con éxito. ¡Ya puedes empezar a cargar gastos!", ModalType.Success);
            Navigation.NavigateTo("/groups");
        }
        else
        {
            ModalService.ShowModal("Error al Crear", "No pudimos guardar el grupo en este momento. Por favor, verifica tu conexión e intenta de nuevo.", ModalType.Error);
        }
    }
}
