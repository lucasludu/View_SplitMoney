@page "/groups/new"
@page "/groups/edit/{GroupId:guid}"
@using SplitMoney.Client.Services
@using SplitMoney.Client.Models.ViewModels
@using System.Security.Claims
@using System.ComponentModel.DataAnnotations
@attribute [Authorize]

<div class="create-group-wrapper">
    <div class="create-group-container px-3 py-5">
        
        <!-- Header -->
        <div class="d-flex align-items-center mb-5 gap-3 fade-in">
            <button class="back-btn" @onclick="GoBack" title="Volver">
                <span class="material-symbols-rounded">arrow_back</span>
            </button>
            <div>
                <p class="header-tag mb-1">@(GroupId.HasValue ? "Configuración" : "Nuevo Círculo")</p>
                <h1 class="brand-font m-0">@(GroupId.HasValue ? "Editar Grupo" : "Crear Grupo")</h1>
            </div>
        </div>

        <div class="premium-card fade-in-up">
            <EditForm Model="formModel" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <!-- Group Identity Section -->
                <div class="section-box mb-4">
                    <div class="input-group-modern mb-1">
                        <span class="material-symbols-rounded input-icon">label</span>
                        <input type="text" class="modern-input group-name-field" placeholder="Nombre del grupo (ej: Viaje, Casa...)" @bind="formModel.GroupName" />
                    </div>
                    <ValidationMessage For="@(() => formModel.GroupName)" />

                    <div class="input-group-modern mt-4 mb-1">
                        <span class="material-symbols-rounded input-icon">description</span>
                        <input type="text" class="modern-input" placeholder="Descripción corta (opcional)" @bind="formModel.Description" />
                    </div>
                    <ValidationMessage For="@(() => formModel.Description)" />
                </div>

                <!-- Members Section -->
                <div class="section-box mb-5">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3 class="section-subtitle m-0">Integrantes</h3>
                        <span class="member-count-badge">@(members.Count) miembros</span>
                    </div>
                    
                    <div class="add-member-input-box mb-4">
                        <div class="input-field-container">
                            <span class="material-symbols-rounded field-icon">alternate_email</span>
                            <input type="email" class="email-input" placeholder="amigo@correo.com" @bind="newMemberEmail" @onkeydown="@(e => { if(e.Key == "Enter") AddMember(); })" />
                        </div>
                        <button type="button" class="add-btn" @onclick="AddMember">
                            <span class="material-symbols-rounded">add</span>
                        </button>
                    </div>

                    <div class="members-stack">
                        @foreach (var m in members)
                        {
                            <div class="member-row fade-in">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="member-avatar">
                                        <UserAvatar Name="@m.Email" />
                                    </div>
                                    <div class="member-info">
                                        <span class="member-email">@m.Email</span>
                                        @if (m.Email == userEmail)
                                        {
                                            <span class="you-pill">Tú (Creador)</span>
                                        }
                                    </div>
                                </div>
                                @if (m.Email != userEmail)
                                {
                                    <button type="button" class="remove-btn" @onclick="() => members.Remove(m)">
                                        <span class="material-symbols-rounded">close</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="action-footer">
                    <button type="submit" class="btn-submit-premium" disabled="@submitting">
                        @if (submitting)
                        {
                            <div class="spinner"></div>
                        }
                        else
                        {
                            <span>@(GroupId.HasValue ? "Guardar Cambios" : "Crear Círculo")</span>
                            <span class="material-symbols-rounded">check_circle</span>
                        }
                    </button>
                    <p class="footer-hint mt-3">Al crear el grupo, se enviará una notificación a los invitados.</p>
                </div>
            </EditForm>
        </div>
    </div>
</div>
