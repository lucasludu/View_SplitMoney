@page "/"
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using SplitMoney.Client.Components.Dashboard
@using SplitMoney.Client.Services
@using SplitMoney.Client.Models.ViewModels
@attribute [Authorize]
@inject AuthenticationStateProvider AuthStateProvider
@inject IExpenseService ExpenseService

<div class="container-fluid px-3 py-4 p-md-4" style="max-width: 1200px; margin: 0 auto;">
    <!-- Welcome Header -->
    <div class="d-flex justify-content-between align-items-start mb-4 gap-2">
        <div class="mb-0" style="min-width: 0;">
            <p class="mb-1" style="color: var(--on-surface-variant); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em;">Master Perspective</p>
            <h1 class="brand-font m-0 h1-responsive text-truncate" style="word-break: break-all;">Hola, <span style="color: var(--primary);">@userName</span></h1>
        </div>
        <div class="d-flex align-items-center gap-2 flex-shrink-0 mt-1">
            <button class="btn rounded-circle shadow-sm" style="background-color: var(--surface-container-highest); width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--outline-variant); transition: transform 0.2s;" @onclick="ShowTipModal" title="Tip del mes">
                <span style="font-size: 1.3rem; line-height: 1;">💡</span>
            </button>
            <div class="hide-on-mobile">
                <span class="badge rounded-pill" style="background-color: var(--surface-container-highest); color: var(--on-surface); padding: 0.75rem 1.25rem; font-weight: 600; font-size: 0.85rem; border: 1px solid var(--outline-variant);">Architect Staff</span>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <!-- Skeleton Stats Grid -->
        <div class="row g-3 mb-4 flex-nowrap overflow-auto pb-2">
            @for (int i = 0; i < 3; i++)
            {
                <div class="col-10 col-md-4">
                    <div class="skeleton" style="height: 120px; border-radius: 1.5rem; width: 100%;"></div>
                </div>
            }
        </div>

        <!-- Skeleton Table -->
        <div class="col-12">
            <div class="skeleton" style="height: 400px; border-radius: 2rem; width: 100%;"></div>
        </div>
    }
    else if (dashboard != null)
    {
        @if (IsDashboardEmpty())
        {
            <div class="editorial-card text-center py-6 px-4 mb-4 shadow-lg border-primary" style="background: linear-gradient(145deg, var(--surface-container-low), var(--surface-container-high)); border: 1.5px dashed var(--primary); opacity: 0.9;">
                <div class="mb-4 mx-auto" style="width: 100px; height: 100px; background: var(--surface-container-highest); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 3.5rem; box-shadow: 0 8px 32px rgba(0,0,0,0.3); border: 2px solid var(--primary);">
                    💰
                </div>
                <h2 class="brand-font mb-3" style="font-size: 2.2rem; color: var(--on-surface);">¡Bienvenido a SplitMoney!</h2>
                <p class="mx-auto mb-5" style="color: var(--on-surface-variant); max-width: 480px; line-height: 1.7; font-size: 1.1rem;">
                    Empieza a dividir tus gastos con amigos y familiares de forma inteligente. Crea tu primer círculo o registra un gasto para ver tus balances aquí.
                </p>
                <div class="d-flex flex-column flex-md-row justify-content-center gap-3">
                    <a href="/groups/new" class="editorial-button-primary d-inline-flex align-items-center justify-content-center gap-2" style="width: auto; padding: 1rem 2.5rem; font-size: 1rem;">
                        <span>Crea un Círculo</span>
                        <span style="font-size: 1.25rem;">👥</span>
                    </a>
                    <a href="/expenses/new" class="btn rounded-pill border-primary d-inline-flex align-items-center justify-content-center gap-2" style="width: auto; padding: 1rem 2.5rem; font-size: 1rem; color: var(--primary);">
                        <span>Cargar Gasto</span>
                        <span style="font-size: 1.25rem;">🚀</span>
                    </a>
                </div>
            </div>
        }
        else
        {
            <StatsGrid TeDeben="dashboard.TotalToReceive" Debes="dashboard.TotalToPay" TotalMes="dashboard.TotalMonthSpending" />

            <!-- Main Dashboard Row -->
            <div class="row g-4">
                <div class="col-12">
                    <RecentExpensesTable Expenses="dashboard.RecentExpenses" OnExpenseSelected="ShowExpenseDetail" />
                </div>
            </div>
        }
    }
    else if (!isLoading && dashboard == null)
    {
        <div class="editorial-card text-center py-6 px-4 mb-4 shadow-lg" style="border: 1.5px solid var(--error-container);">
            <div class="mb-4 mx-auto" style="width: 80px; height: 80px; background: var(--error-container); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; color: white;">
                ❌
            </div>
            <h2 class="brand-font mb-2" style="font-size: 1.5rem; color: var(--on-surface);">Error de Conexión</h2>
            <p class="mx-auto mb-4" style="color: var(--on-surface-variant); max-width: 320px; line-height: 1.6; font-size: 0.95rem;">
                No pudimos conectar con el servidor. Reintenta o revisa si la API está encendida y el puerto 7042 accesible.
            </p>
            <button class="editorial-button-primary" style="width: auto; padding: 0.75rem 2rem;" @onclick="OnInitializedAsync">
                Reintentar 🔄
            </button>
        </div>
    }
</div>

<!-- Expense Detail Overlay -->
@if (selectedExpense != null)
{
    <div class="details-overlay" @onclick="CloseExpenseDetail">
        <div class="details-panel shadow-lg" @onclick:stopPropagation="true">
            <div class="d-flex justify-content-between align-items-center p-3 border-bottom" style="border-color: var(--outline-variant) !important; background: var(--surface-container-low); border-radius: 2rem 2rem 0 0;">
                <div class="d-flex align-items-center gap-3">
                    <div class="shadow-sm" style="width: 40px; height: 40px; border-radius: 12px; background-color: var(--surface-container-highest); display: flex; align-items: center; justify-content: center; font-size: 1.1rem; border: 1.5px solid @selectedExpense.CategoryColor;">
                        @selectedExpense.CategoryIcon
                    </div>
                    <div>
                        <h2 class="brand-font m-0 h5">@selectedExpense.Description</h2>
                        <p class="m-0 small text-muted" style="font-size: 0.7rem;">@selectedExpense.Date.ToString("f")</p>
                    </div>
                </div>
                <button class="btn-close-custom" @onclick="CloseExpenseDetail">✕</button>
            </div>

            <div class="p-4 custom-scroll" style="overflow-y: auto; max-height: calc(85vh - 80px);">
                <!-- Total Amount Summary -->
                <div class="text-center mb-4 p-3 rounded-4" style="background: linear-gradient(145deg, var(--surface-container-low), var(--surface-container-high)); border: 1px solid var(--outline-variant);">
                    <p class="mb-1 text-uppercase fw-bold" style="font-size: 0.65rem; color: var(--on-surface-variant); opacity: 0.8; letter-spacing: 0.1em;">Importe Total del Gasto</p>
                    <h2 class="brand-font m-0" style="color: var(--primary); font-size: 2.2rem;">@selectedExpense.TotalAmount.ToString("C0")</h2>
                    <p class="mt-1 mb-0 fw-600" style="font-size: 0.8rem; color: var(--on-surface);">Círculo: <span class="badge rounded-pill bg-primary" style="font-size: 0.65rem; padding: 0.3rem 0.6rem;">@selectedExpense.GroupName</span></p>
                </div>

                <!-- Payments Section -->
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div style="width: 4px; height: 16px; background: #10b981; border-radius: 4px;"></div>
                        <h5 class="section-label m-0">QUIÉN PAGÓ EL TOTAL</h5>
                    </div>
                    <div class="balances-list">
                        @foreach (var payment in selectedExpense.Payments)
                        {
                            <div class="balance-item p-3 mb-2 d-flex justify-content-between align-items-center" style="background: rgba(16, 185, 129, 0.03);">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="member-avatar" style="background: var(--surface-container-highest); color: var(--on-surface); border: 1px solid var(--outline-variant);">@payment.UserName.Substring(0, 1).ToUpper()</div>
                                    <span class="fw-bold" style="font-size: 0.95rem; text-transform: capitalize;">@payment.UserName</span>
                                </div>
                                <div class="amount-badge bg-success text-white border-0" style="font-size: 0.85rem;">
                                    + @payment.Amount.ToString("C0")
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Splits Section -->
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div style="width: 4px; height: 16px; background: #ef4444; border-radius: 4px;"></div>
                        <h5 class="section-label m-0">CÓMO SE DIVIDIÓ (DEUDAS)</h5>
                    </div>
                    <div class="balances-list">
                        @foreach (var split in selectedExpense.Splits)
                        {
                            <div class="balance-item p-3 mb-2 d-flex justify-content-between align-items-center" style="opacity: @(split.AmountOwed > 0 ? "1" : "0.6"); background: rgba(239, 68, 68, 0.03);">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="member-avatar" style="background: var(--surface-container-highest); color: var(--on-surface); border: 1px solid var(--outline-variant);">@split.UserName.Substring(0, 1).ToUpper()</div>
                                    <span style="font-size: 0.95rem; text-transform: capitalize;">@split.UserName</span>
                                </div>
                                <div class="amount-badge @(split.AmountOwed > 0 ? "bg-danger text-white" : "bg-secondary-subtle text-muted") border-0" style="font-size: 0.85rem;">
                                    @split.AmountOwed.ToString("C0")
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- NEW: Net Balance Summary Section -->
                <div class="mb-2">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div style="width: 4px; height: 16px; background: var(--primary); border-radius: 4px;"></div>
                        <h5 class="section-label m-0">BALANCE FINAL POR PERSONA</h5>
                    </div>
                    <div class="balances-list">
                        @foreach (var memberName in GetAllInvolvedMembers())
                        {
                            var paid = selectedExpense.Payments.Where(p => p.UserName == memberName).Sum(p => p.Amount);
                            var owed = selectedExpense.Splits.Where(s => s.UserName == memberName).Sum(s => s.AmountOwed);
                            var diff = paid - owed;

                            <div class="balance-item p-3 mb-2 d-flex justify-content-between align-items-center" style="background: var(--surface-container-high); border: 1px solid @(diff > 0 ? "#10b981" : diff < 0 ? "#ef4444" : "var(--outline-variant)"); border-radius: 1rem; border-width: 1px 1px 1px 5px;">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="member-avatar" style="background: @(diff > 0 ? "#10b981" : diff < 0 ? "#ef4444" : "var(--surface-container-highest)"); color: white;">@memberName.Substring(0, 1).ToUpper()</div>
                                    <div>
                                        <p class="m-0 fw-bold" style="font-size: 0.95rem; text-transform: capitalize;">@memberName</p>
                                        <p class="m-0 x-small text-muted" style="font-size: 0.7rem;">Puso @paid.ToString("C0") / Gasto @owed.ToString("C0")</p>
                                    </div>
                                </div>
                                <div class="text-end">
                                    @if (diff > 0)
                                    {
                                        <p class="m-0 small text-success fw-bold text-uppercase" style="font-size: 0.6rem;">A recibir</p>
                                        <p class="m-0 fw-bold text-success" style="font-size: 1.1rem;">+@diff.ToString("C0")</p>
                                    }
                                    else if (diff < 0)
                                    {
                                        <p class="m-0 small text-danger fw-bold text-uppercase" style="font-size: 0.6rem;">Debe poner</p>
                                        <p class="m-0 fw-bold text-danger" style="font-size: 1.1rem;">@diff.ToString("C0")</p>
                                    }
                                    else
                                    {
                                        <p class="m-0 fw-bold text-muted" style="font-size: 1.1rem;">$0</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            
            <div class="p-3 border-top text-center" style="border-color: var(--outline-variant) !important; background: var(--surface-container-lowest);">
                <button class="editorial-button-primary w-100 py-3" @onclick="CloseExpenseDetail" style="font-size: 1rem;">
                    Entendido ✅
                </button>
            </div>
        </div>
    </div>
}

<MonthlyTipModal IsOpen="isTipModalOpen" OnClose="CloseTipModal" />

<style>
    /* Custom Scrollbar for Premium Feel */
    .custom-scroll::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scroll::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scroll::-webkit-scrollbar-thumb {
        background: var(--outline-variant);
        border-radius: 10px;
    }
    .custom-scroll::-webkit-scrollbar-thumb:hover {
        background: var(--on-surface-variant);
    }

    .details-overlay {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.75); backdrop-filter: blur(10px);
        z-index: 2000; display: flex; justify-content: center; align-items: flex-end;
    }
    .details-panel {
        width: 100%; max-width: 500px; background: var(--surface-container-lowest);
        border-radius: 2rem 2rem 0 0; max-height: 85vh;
        animation: slide-up 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex; flex-direction: column; border: 1px solid var(--outline-variant);
    }
    @@keyframes slide-up { from { transform: translateY(100%); } to { transform: translateY(0); } }
    .btn-close-custom {
        background: var(--surface-container-highest); border: none; width: 36px; height: 36px;
        border-radius: 50%; color: var(--on-surface); display: flex; align-items: center; justify-content: center;
        font-weight: bold; transition: transform 0.2s;
    }
    .section-label { font-size: 0.7rem; letter-spacing: 0.15em; color: var(--on-surface-variant); font-weight: 800; opacity: 0.7; }
    .balance-item { background: var(--surface-container-low); border: 1px solid var(--outline-variant); border-radius: 1rem; }
    .member-avatar { width: 32px; height: 32px; background: var(--primary); color: white; border-radius: 50%; font-size: 0.8rem; display: flex; align-items: center; justify-content: center; font-weight: bold; }
    .amount-badge { padding: 4px 12px; border-radius: 100px; font-weight: 700; font-size: 0.85rem; }

    @@media (min-width: 768px) {
        .details-overlay { align-items: center; padding: 2rem; }
        .details-panel { border-radius: 2rem; }
    }

    .skeleton {
        background: linear-gradient(90deg, 
            var(--surface-container-high) 25%, 
            var(--surface-container-highest) 50%, 
            var(--surface-container-high) 75%);
        background-size: 200% 100%;
        animation: loading-shimmer 1.5s infinite;
        border: 1px solid var(--outline-variant);
    }

    @@keyframes loading-shimmer {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }
</style>

@code {
    private string userName = "User";
    private bool isTipModalOpen = false;
    private DashboardViewModel? dashboard;
    private bool isLoading = true;
    private ExpenseDetailViewModel? selectedExpense;

    private void ShowTipModal() => isTipModalOpen = true;
    private void CloseTipModal() => isTipModalOpen = false;

    private async Task ShowExpenseDetail(Guid expenseId)
    {
        selectedExpense = await ExpenseService.GetExpenseDetailsAsync(expenseId);
        StateHasChanged();
    }

    private void CloseExpenseDetail()
    {
        selectedExpense = null;
    }

    private IEnumerable<string> GetAllInvolvedMembers()
    {
        if (selectedExpense == null) return Enumerable.Empty<string>();
        
        var paymentUsers = selectedExpense.Payments.Select(p => p.UserName);
        var splitUsers = selectedExpense.Splits.Select(s => s.UserName);
        
        return paymentUsers.Union(splitUsers).Distinct().OrderBy(u => u);
    }

    private bool IsDashboardEmpty() => 
        dashboard == null || 
        (dashboard.TotalToReceive == 0 && 
         dashboard.TotalToPay == 0 && 
         dashboard.TotalMonthSpending == 0 && 
         (dashboard.RecentExpenses == null || !dashboard.RecentExpenses.Any()));

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        
        if (user.Identity?.IsAuthenticated == true)
        {
            var firstName = user.Claims.FirstOrDefault(c => c.Type == "FirstName" || c.Type == ClaimTypes.Name)?.Value;
            if (!string.IsNullOrEmpty(firstName))
                userName = firstName;
        }

        dashboard = await ExpenseService.GetDashboardAsync();
        isLoading = false;
    }
}
