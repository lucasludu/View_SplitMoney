@page "/"
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using SplitMoney.Client.Components.Dashboard
@using SplitMoney.Client.Services
@using SplitMoney.Client.Models.ViewModels
@implements IDisposable
@attribute [Authorize]
@inject AuthenticationStateProvider AuthStateProvider
@inject IExpenseService ExpenseService
@inject ITipService TipService
@inject NavigationManager Navigation
@inject IToastService ToastService
@inject IModalService ModalService
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

@inject INotificationService NotificationService

<style>
    /* Notification Styles */
    .notification-trigger-container {
        position: relative;
        display: inline-block;
    }

    .notification-badge {
        position: absolute;
        top: -2px;
        right: -2px;
        background: var(--primary);
        color: white;
        font-size: 0.65rem;
        font-weight: 700;
        min-width: 18px;
        height: 18px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid var(--background);
        z-index: 5;
    }

    .notification-overlay-home {
        position: absolute;
        top: 55px;
        right: 0;
        z-index: 9999; /* Máxima prioridad */
        animation: fadeInDown 0.3s ease-out;
    }

    .notification-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 9990;
        background: transparent;
    }

    @@keyframes fadeInDown {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .header-main-wrapper {
        position: relative;
        z-index: 100; /* Prioridad sobre el contenido de abajo */
    }

    @@media (max-width: 767.98px) {
        .notification-overlay-home {
            position: fixed;
            top: 70px;
            right: 15px;
            left: 15px;
            z-index: 9999 !important;
        }
        .notification-overlay-home > div {
            width: 100% !important;
        }
    }
</style>

<div class="container-fluid px-3 py-4 p-md-4 container-max">
   
    <!-- Welcome Header Wrapper -->
    <div class="header-main-wrapper fade-in">
        <div class="d-flex justify-content-between align-items-start mb-4 gap-2">
            <div class="mb-0" style="min-width: 0;">
                <p class="perspective-label mb-1">
                    <span class="material-symbols-rounded" style="font-size: 0.9rem; vertical-align: middle;">@(isPremium ? "workspace_premium" : "person")</span>
                    @(isPremium ? "Master Perspective" : "Personal View")
                </p>
                <h1 class="brand-font m-0 h1-responsive text-truncate home-title">Hola, <span>@userName</span></h1>
            </div>
            <div class="d-flex align-items-center gap-2 flex-shrink-0 mt-1">
                <div class="notification-trigger-container">
                    <button class="btn circle-btn-container" @onclick="ToggleNotifications" title="Notificaciones">
                        <span class="material-symbols-rounded">notifications</span>
                    </button>
                    @if (unreadCount > 0)
                    {
                        <span class="notification-badge">@unreadCount</span>
                    }

                    @if (showNotifications)
                    {
                        <div class="notification-overlay-home shadow-lg">
                            <NotificationCenter />
                        </div>
                        <div class="notification-backdrop" @onclick="() => showNotifications = false"></div>
                    }
                </div>
                <div class="hide-on-mobile">
                    <span class="badge architect-badge">@(isPremium ? "Premium Member" : "Standard Account")</span>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <!-- Skeleton Stats Grid -->
        <div class="stats-skeleton-container mb-4">
            <div class="skeleton-stat-card"></div>
            <div class="skeleton-stat-card"></div>
            <div class="skeleton-stat-card"></div>
        </div>

        <!-- Skeleton Table -->
        <div class="col-12">
            <div class="skeleton" style="height: 400px; border-radius: 1.5rem; width: 100%;"></div>
        </div>
    }
    else if (dashboard != null)
    {
        @if (IsDashboardEmpty())
        {
            <div class="empty-dashboard-card text-center p-5 mb-4 fade-in">
                <div class="empty-icon-box mb-4">
                    <span class="material-symbols-rounded">account_balance_wallet</span>
                </div>
                <h2 class="brand-font mb-3">¡Bienvenido a SplitMoney!</h2>
                <p class="empty-text mb-5">
                    Empieza a dividir tus gastos con amigos y familiares de forma inteligente. Crea tu primer círculo o registra un gasto para ver tus balances aquí.
                </p>
                <div class="d-flex flex-column flex-md-row justify-content-center gap-3">
                    <a href="/groups/new" class="editorial-button-primary d-inline-flex align-items-center justify-content-center gap-2" style="width: auto; padding: 1rem 2rem;">
                        <span>Crear un Círculo</span>
                        <span class="material-symbols-rounded">group_add</span>
                    </a>
                    <button @onclick="HandleCreateExpenseClick" class="btn modern-outline-btn d-inline-flex align-items-center justify-content-center gap-2">
                        <span>Cargar Gasto</span>
                        <span class="material-symbols-rounded">add_circle</span>
                    </button>
                </div>
            </div>
        }
        else
        {
            <StatsGrid TeDeben="dashboard.TotalToReceive" Debes="dashboard.TotalToPay" TotalMes="dashboard.TotalMonthSpending" />

            <!-- Main Dashboard Row -->
            <div class="row g-4 fade-in-up">
                <div class="col-12">
                    <RecentExpensesTable Expenses="dashboard.RecentExpenses" OnExpenseSelected="ShowExpenseDetail" />
                </div>
            </div>
        }
    }
    else if (!isLoading && dashboard == null)
    {
        <div class="error-card text-center p-5 mb-4 fade-in">
            <div class="error-icon-box mb-4">
                <span class="material-symbols-rounded">error</span>
            </div>
            <h2 class="brand-font mb-2">Error de Conexión</h2>
            <p class="error-text mb-4">
                No pudimos conectar con el servidor. Reintenta o revisa tu conexión.
            </p>
            <button class="editorial-button-primary" style="width: auto; padding: 0.75rem 2rem;" @onclick="OnInitializedAsync">
                Reintentar
            </button>
        </div>
    }
</div>

<!-- Expense Detail Overlay -->
@if (selectedExpense != null)
{
    <div class="details-overlay" @onclick="CloseExpenseDetail">
        <div class="details-panel shadow-lg" @onclick:stopPropagation="true">
            <!-- Header -->
            <div class="px-4 py-3 border-bottom d-flex align-items-center justify-content-between panel-header">
                <div class="d-flex align-items-center gap-3">
                    <div style="background: @(selectedExpense.CategoryColor)20; border: 1.5px solid @selectedExpense.CategoryColor; width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center;">
                        <span style="font-size: 1.5rem;">@selectedExpense.CategoryIcon</span>
                    </div>
                    <div>
                        <h5 class="brand-font m-0 panel-title">@selectedExpense.Description</h5>
                        <p class="small text-editorial-muted m-0">@selectedExpense.Date.ToString("d MMM yyyy") en @selectedExpense.GroupName</p>
                    </div>
                </div>
                <button class="btn btn-sm rounded-circle p-1 panel-close-btn" @onclick="CloseExpenseDetail">✕</button>
            </div>

            <!-- Tab Selector -->
            <div class="px-4 border-bottom d-flex gap-4 tab-selector-container">
                <button class="btn btn-link px-0 py-2 text-decoration-none border-bottom border-3 @(!showAudit ? "border-primary fw-bold text-primary" : "border-transparent")" 
                        style="font-size: 0.85rem; @(!showAudit ? "" : "color: var(--on-surface-variant);")" 
                        @onclick="() => showAudit = false">Detalles</button>
                <button class="btn btn-link px-0 py-2 text-decoration-none border-bottom border-3 @(showAudit ? "border-primary fw-bold text-primary" : "border-transparent")" 
                        style="font-size: 0.85rem; @(showAudit ? "" : "color: var(--on-surface-variant);")" 
                        @onclick="LoadAudit">
                    Historial de Cambios @(!isPremium ? "👑" : "")
                </button>
            </div>

            <div class="p-4" style="max-height: 60vh; overflow-y: auto;">
                @if (!showAudit)
                {
                    <div class="mb-4 text-center p-4 rounded-4 amount-hero-box">
                        <p class="text-editorial-muted small mb-1 amount-hero-label">Monto Total</p>
                        <h2 class="brand-font display-5 m-0" style="color: var(--primary);">@selectedExpense.TotalAmount.ToString("C2")</h2>
                    </div>

                    <!-- Payments Section -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <div style="width: 4px; height: 16px; background: #10b981; border-radius: 4px;"></div>
                            <h5 class="section-label m-0">QUIÉN PAGÓ EL TOTAL</h5>
                        </div>
                        <div class="balances-list">
                            @foreach (var payment in selectedExpense.Payments)
                            {
                                <div class="balance-item p-3 mb-2 d-flex justify-content-between align-items-center" style="background: rgba(16, 185, 129, 0.03);">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="member-avatar" style="background: var(--surface-container-highest); color: var(--on-surface); border: 1px solid var(--outline-variant);">@payment.UserName.Substring(0, 1).ToUpper()</div>
                                        <span class="fw-bold member-row-info">@payment.UserName</span>
                                    </div>
                                    <div class="amount-badge bg-success text-white border-0">
                                        + @payment.Amount.ToString("C0")
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Splits Section -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <div style="width: 4px; height: 16px; background: #ef4444; border-radius: 4px;"></div>
                            <h5 class="section-label m-0">CÓMO SE DIVIDIÓ (DEUDAS)</h5>
                        </div>
                        <div class="balances-list">
                            @foreach (var split in selectedExpense.Splits)
                            {
                                <div class="balance-item p-3 mb-2 d-flex justify-content-between align-items-center" style="opacity: @(split.AmountOwed > 0 ? "1" : "0.6"); background: rgba(239, 68, 68, 0.03);">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="member-avatar" style="background: var(--surface-container-highest); color: var(--on-surface); border: 1px solid var(--outline-variant);">@split.UserName.Substring(0, 1).ToUpper()</div>
                                        <span class="member-row-info">@split.UserName</span>
                                    </div>
                                    <div class="amount-badge @(split.AmountOwed > 0 ? "bg-danger text-white" : "bg-secondary-subtle text-editorial-muted") border-0">
                                        @split.AmountOwed.ToString("C0")
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Net Balance Summary Section -->
                    <div class="mb-2">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <div style="width: 4px; height: 16px; background: var(--primary); border-radius: 4px;"></div>
                            <h5 class="section-label m-0">BALANCE FINAL POR PERSONA</h5>
                        </div>
                        <div class="balances-list">
                            @foreach (var memberName in GetAllInvolvedMembers())
                            {
                                var paid = selectedExpense.Payments.Where(p => p.UserName == memberName).Sum(p => p.Amount);
                                var owed = selectedExpense.Splits.Where(s => s.UserName == memberName).Sum(s => s.AmountOwed);
                                var diff = paid - owed;

                                <div class="balance-item p-3 mb-2 d-flex justify-content-between align-items-center final-balance-card" style="border: 1px solid @(diff > 0 ? "#10b981" : diff < 0 ? "#ef4444" : "var(--outline-variant)");">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="member-avatar" style="background: @(diff > 0 ? "#10b981" : diff < 0 ? "#ef4444" : "var(--surface-container-highest)"); color: white;">@memberName.Substring(0, 1).ToUpper()</div>
                                        <div>
                                            <p class="m-0 fw-bold member-row-info">@memberName</p>
                                            <p class="m-0 x-small text-editorial-muted" style="font-size: 0.7rem;">Puso @paid.ToString("C0") / Gasto @owed.ToString("C0")</p>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        @if (diff > 0)
                                        {
                                            <p class="m-0 small text-success fw-bold text-uppercase balance-diff-label">A recibir</p>
                                            <p class="m-0 fw-bold text-success balance-diff-value">+@diff.ToString("C0")</p>
                                        }
                                        else if (diff < 0)
                                        {
                                            <p class="m-0 small text-danger fw-bold text-uppercase balance-diff-label">Debe poner</p>
                                            <p class="m-0 fw-bold text-danger balance-diff-value">@diff.ToString("C0")</p>
                                        }
                                        else
                                        {
                                            <p class="m-0 fw-bold text-editorial-muted balance-diff-value">$0</p>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    @if (loadingAudit)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border spinner-border-sm text-primary"></div>
                            <p class="mt-2 small text-editorial-muted">Recuperando historial...</p>
                        </div>
                    }
                    else if (auditHistory?.History.Any() == true)
                    {
                        <div class="audit-timeline">
                            @foreach (var log in auditHistory.History.OrderByDescending(l => l.ChangeDate))
                            {
                                <div class="audit-item mb-4 ps-4 position-relative">
                                    <div class="audit-marker"></div>
                                    <p class="small fw-bold mb-1" style="color: var(--on-surface);">@log.Action</p>
                                    <p class="small text-editorial-muted mb-2" style="font-size: 0.75rem;">
                                        Por <span class="text-primary">@log.ModifiedBy</span> • @log.ChangeDate.ToString("g")
                                    </p>
                                    <div class="p-2 rounded-3" style="background: var(--surface-container-high); font-size: 0.8rem;">
                                        <div class="row g-1">
                                            <div class="col-5 text-editorial-muted">De: @(string.IsNullOrEmpty(log.PreviousValue) ? "-" : log.PreviousValue)</div>
                                            <div class="col-2 text-center text-primary">→</div>
                                            <div class="col-5 fw-bold">A: @log.NewValue</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 opacity-50">
                            <span style="font-size: 2.5rem;">📜</span>
                            <p class="mt-2 small">No hay cambios registrados para este gasto aún.</p>
                        </div>
                    }
                }
            </div>
            
            <div class="p-3 border-top d-flex gap-2" style="border-color: var(--outline-variant) !important; background: var(--surface-container-lowest);">
                @if (selectedExpense != null)
                {
                    <button class="btn btn-outline-danger rounded-pill px-4" @onclick="ConfirmDelete" disabled="@isDeleting" style="font-size: 0.9rem; font-weight: 700;">
                        @if (isDeleting) { <span class="spinner-border spinner-border-sm"></span> }
                        else { <span>🗑️ Borrar</span> }
                    </button>
                    <button class="btn btn-outline-primary rounded-pill px-4" @onclick="NavigateToEdit" style="font-size: 0.9rem; font-weight: 700;">
                        ✏️ Editar
                    </button>
                }
                <button class="editorial-button-primary flex-grow-1" @onclick="CloseExpenseDetail" style="font-size: 1rem;">
                    Entendido ✅
                </button>
            </div>
        </div>
    </div>
}

<MonthlyTipModal IsOpen="isTipModalOpen" Tip="currentTip" OnClose="CloseTipModal" />

@if (showPaywall)
{
    <PremiumPaywall Title="@paywallTitle" OnClose="() => showPaywall = false" OnUpgrade="HandleUpgrade" OnSimulate="HandleSimulatePremium" />
}

@code {
    private string userName = "User";
    private bool isTipModalOpen = false;
    private DashboardViewModel? dashboard;
    private bool isLoading = true;
    private bool isDeleting = false;
    private bool isPremium = false;
    private bool showAudit = false;
    private bool loadingAudit = false;
    private bool showPaywall = false;
    private bool showNotifications = false;
    private int unreadCount = 0;
    private string paywallTitle = "Controle su Dinero";
    private TipViewModel? currentTip;
    private ExpenseAuditViewModel? auditHistory;
    private ExpenseDetailViewModel? selectedExpense;
    private AuthenticationState? authState;

    private void ShowTipModal() => isTipModalOpen = true;
    private void CloseTipModal() => isTipModalOpen = false;
    private void HandleUpgrade() => Navigation.NavigateTo("/premium");
    private async Task HandleSimulatePremium() 
    {
        isPremium = true;
        await LocalStorage.SetItemAsync("is_simulated_premium", true);
        ToastService.ShowToast("🌟 MODO PREMIUM ACTIVADO (SIMULACIÓN)", ToastLevel.Info);
        StateHasChanged();
    }

    private async Task ShowExpenseDetail(Guid expenseId)
    {
        showAudit = false; // Reset to details tab
        auditHistory = null;
        selectedExpense = await ExpenseService.GetExpenseDetailsAsync(expenseId);
        StateHasChanged();
    }

    private async Task LoadAudit()
    {
        if (selectedExpense == null) return;
        if (!isPremium)
        {
            paywallTitle = "Historial de Cambios";
            showPaywall = true;
            return;
        }
        showAudit = true;
        loadingAudit = true;
        auditHistory = await ExpenseService.GetExpenseAuditAsync(selectedExpense.Id);
        loadingAudit = false;
    }

    private void CloseExpenseDetail()
    {
        selectedExpense = null;
    }

    private async Task ConfirmDelete()
    {
        if (selectedExpense == null) return;
        
        isDeleting = true;
        var success = await ExpenseService.DeleteExpenseAsync(selectedExpense.Id);
        isDeleting = false;

        if (success)
        {
            ToastService.ShowToast("Gasto eliminado 🗑️", ToastLevel.Success);
            selectedExpense = null;
            await OnInitializedAsync(); // Refresh dashboard
        }
        else
        {
            ToastService.ShowToast("No se pudo eliminar el gasto", ToastLevel.Error);
        }
    }

    private void NavigateToEdit()
    {
        if (selectedExpense != null)
        {
            Navigation.NavigateTo($"/expenses/edit/{selectedExpense.Id}");
        }
    }

    private IEnumerable<string> GetAllInvolvedMembers()
    {
        if (selectedExpense == null) return Enumerable.Empty<string>();
        
        var paymentUsers = selectedExpense.Payments.Select(p => p.UserName);
        var splitUsers = selectedExpense.Splits.Select(s => s.UserName);
        
        return paymentUsers.Union(splitUsers).Distinct().OrderBy(u => u);
    }

    private bool IsDashboardEmpty() => 
        dashboard == null || 
        (dashboard.TotalToReceive == 0 && 
         dashboard.TotalToPay == 0 && 
         dashboard.TotalMonthSpending == 0 && 
         (dashboard.RecentExpenses == null || !dashboard.RecentExpenses.Any()));

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        
        NotificationService.NotificationsChanged += OnNotificationsChanged;

        authState = await AuthStateProvider.GetAuthenticationStateAsync();
        
        // Cargar estado premium real o simulado
        var isRealPremium = authState.User.IsInRole("PremiumUser");
        var isSimulatedPremium = await LocalStorage.GetItemAsync<bool>("is_simulated_premium");
        isPremium = isRealPremium || isSimulatedPremium;

        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var firstName = user.Claims.FirstOrDefault(c => c.Type == "FirstName" || c.Type == ClaimTypes.Name)?.Value;
            if (!string.IsNullOrEmpty(firstName))
                userName = firstName;
        }
        dashboard = await ExpenseService.GetDashboardAsync();
        currentTip = TipService.GetMonthlyTip();
        
        await RefreshUnreadCount();

        isLoading = false;
    }

    private async Task RefreshUnreadCount()
    {
        var notifications = await NotificationService.GetNotificationsAsync();
        unreadCount = notifications.Count(n => !n.IsRead);
    }

    private void ToggleNotifications()
    {
        showNotifications = !showNotifications;
        StateHasChanged();
    }

    private async Task HandleCreateExpenseClick()
    {
        var groups = await ExpenseService.GetUserGroupsAsync();
        if (groups == null || !groups.Any())
        {
            ModalService.ShowModal("No hay Grupos", "Debes pertenecer a un círculo antes de cargar gastos. Crea tu primer grupo ahora.", ModalType.Warning);
            Navigation.NavigateTo("/groups");
        }
        else
        {
            Navigation.NavigateTo("/expenses/new");
        }
    }

    private async void OnNotificationsChanged()
    {
        await InvokeAsync(async () => 
        {
            await RefreshUnreadCount();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        NotificationService.NotificationsChanged -= OnNotificationsChanged;
    }
}
